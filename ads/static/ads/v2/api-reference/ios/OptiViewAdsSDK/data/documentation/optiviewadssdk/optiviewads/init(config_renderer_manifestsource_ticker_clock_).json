 orchestrator ("},{"type":"codeVoice","code":"OptiViewAds"},{"type":"text","text":") stays player-agnostic and"},{"text":" ","type":"text"},{"type":"text","text":"delegates everything that touches a media surface, an overlay, or GAM\/IMA to"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AdRenderer"},{"type":"text","text":". The Apple runtime renderer (AVPlayer ad player + overlay +"},{"text":" ","type":"text"},{"text":"IMA DAI) implements this in the player phase; tests supply a fake.","type":"text"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdRenderer","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/SchedulerTicker":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SchedulerTicker"}],"kind":"symbol","url":"\/documentation\/optiviewadssdk\/schedulerticker","title":"SchedulerTicker","type":"topic","identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/SchedulerTicker","abstract":[{"text":"The scheduler-tick boundary — the Swift mirror of ","type":"text"},{"code":"android\/ads-sdk","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"code":"SchedulerTicker","type":"codeVoice"},{"text":". The core ","type":"text"},{"code":"BreakScheduler","type":"codeVoice"},{"text":" has no internal timer (for","type":"text"},{"text":" ","type":"text"},{"text":"deterministic conformance), so the platform supplies the cadence behind this","type":"text"},{"text":" ","type":"text"},{"text":"protocol (the default ","type":"text"},{"code":"DispatchSchedulerTicker","type":"codeVoice"},{"text":" uses a ","type":"text"},{"code":"DispatchSourceTimer","type":"codeVoice"},{"text":").","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SchedulerTicker"}],"role":"symbol"}}}