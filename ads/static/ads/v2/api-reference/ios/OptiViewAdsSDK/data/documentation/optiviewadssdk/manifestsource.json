text"},{"code":"DA-MANIFEST-INTERCEPT-FAILED","type":"codeVoice"},{"text":" and falls back to the","type":"text"},{"text":" ","type":"text"},{"text":"un-modified parsed manifest (the fetch does not fail). Mirrors the web","type":"text"},{"text":" ","type":"text"},{"code":"ManifestResponseInterceptor","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/ManifestSource/takeLastFailure()":{"type":"topic","title":"takeLastFailure()","defaultImplementations":1,"kind":"symbol","required":true,"identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/ManifestSource\/takeLastFailure()","role":"symbol","url":"\/documentation\/optiviewadssdk\/manifestsource\/takelastfailure()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeLastFailure","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14OptiViewAdsSDK21ManifestFetchEvidenceV","text":"ManifestFetchEvidence","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Evidence for the most recent failed read, consumed by the caller raising"},{"type":"text","text":" "},{"type":"codeVoice","code":"DA-MANIFEST-FETCH-FAILED"},{"type":"text","text":". Defaults to nil so a custom source keeps"},{"type":"text","text":" "},{"type":"text","text":"working without implementing it — it loses the evidence, not the diagnostic."}]},"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/ManifestRequestInterceptor":{"url":"\/documentation\/optiviewadssdk\/manifestrequestinterceptor","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ManifestRequestInterceptor"}],"navigatorTitle":[{"kind":"identifier","text":"ManifestRequestInterceptor"}],"identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/ManifestRequestInterceptor","abstract":[{"text":"Customer hook to i