 "},{"type":"text","text":"Anvato timed-metadata cues from the content player — HLS ID3 GEOB frames"},{"type":"text","text":" "},{"type":"text","text":"with description "},{"type":"codeVoice","code":"Anvatos"},{"type":"text","text":" (MIME "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":") and DASH emsg events"},{"type":"text","text":" "},{"type":"text","text":"with scheme "},{"type":"codeVoice","code":"urn:anvato:es1:052016"},{"type":"text","text":" — whose payload is a query string of"},{"type":"text","text":" "},{"type":"text","text":"the form "},{"type":"codeVoice","code":"type=cue&pts=<seconds>"},{"type":"text","text":". A "},{"type":"codeVoice","code":"timebase: \"pts\""},{"type":"text","text":" break is then"},{"type":"text","text":" "},{"type":"text","text":"scheduled at the media time of the observed cue whose "},{"type":"codeVoice","code":"pts"},{"type":"text","text":" matches the"},{"type":"text","text":" "},{"type":"text","text":"break’s "},{"type":"codeVoice","code":"start"},{"type":"text","text":" (±5 ms); a break whose cue has not been observed yet stays"},{"type":"text","text":" "},{"type":"text","text":"pending (surfaced once per break via the "},{"type":"codeVoice","code":"DA-ANVATO-CUE-PENDING"},{"type":"text","text":" "},{"type":"text","text":"diagnostic). SGAI only; has no effect on wallclock-timebase manifests."},{"type":"text","text":" "},{"type":"text","text":"Mirrors the web "},{"type":"codeVoice","code":"ptsSource"},{"type":"text","text":" config. Defaults to "},{"type":"codeVoice","code":".mediaTime"},{"type":"text","text":"."}],"title":"ptsSource","kind":"symbol","identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig\/ptsSource","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ptsSource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14OptiViewAdsSDK9PtsSourceO","text":"PtsSource"}],"typ