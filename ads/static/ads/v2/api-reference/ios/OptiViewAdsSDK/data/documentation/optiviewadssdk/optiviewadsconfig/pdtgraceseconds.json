{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"How long, in seconds, to wait for the stream’s "},{"type":"codeVoice","code":"EXT-X-PROGRAM-DATE-TIME"},{"type":"text","text":" on a"},{"type":"text","text":" "},{"type":"codeVoice","code":"wallclock"},{"type":"text","text":"-timebase session before concluding the stream carries none."}],"hierarchy":{"paths":[["doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK","doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig"]]},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdtGraceSeconds","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A session is normally started before the content player has loaded its"},{"type":"text","text":" "},{"type":"text","text":"source, so the scheduler’s first ticks see no PDT even on a stream that does"},{"type":"text","text":" "},{"type":"text","text":"carry it. Those ticks make no scheduling decision, rather than matching breaks"},{"type":"text","text":" "},{"type":"text","text":"against the system clock — which runs ahead of the live playhead by the"},{"type":"text","text":" "},{"type":"text","text":"stream’s latency and would fire a break early (PLAYG-360)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a "},{"type":"strong","inlineContent":[{"type":"text","text":"backstop, not a fixed delay"}]},{"type":"text","text":". The SDK stops waiting at whichever"},{"type":"text","text":" "},{"type":"text","text":"comes first: content has been playing for ~1s and still exposes no PDT (direct"},{"type":"text","text":" "},{"type":"text","text":"evidence about the stream — "},{"code":"DA-PDT-MISSING","type":"codeVoice"},{"type":"text","text":" is emitted once and the clock"},{"type":"text","text":" "},{"type":"text","text":"takes over immediately, so a join-in-progress break is not delayed below the"},{"type":"text","text":" "},{"type":"text","text":"tune-in minimum), or this window elapses (the backstop for a player that never"},{"type":"text","text":" "},{"text":"starts).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to fall back to the system clock immediately. Has no effect on"},{"type":"text","text":" "},{"type":"codeVoice","code":"pts"},{"type":"text","text":"-timebase manifests. Mirrors the web "},{"type":"codeVoice","code":"pdtGraceSeconds"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadssdk\/optiviewadsconfig\/pdtgraceseconds"]}],"metadata":{"symbolKind":"property","title":"pdtGraceSeconds","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"pdtGraceSeconds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"role":"symbol","modules":[{"name":"OptiViewAdsSDK"}],"roleHeading":"Instance Property","externalID":"s:14OptiViewAdsSDK0abC6ConfigV15pdtGraceSecondsSdvp"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig\/pdtGraceSeconds"},"sections":[],"references":{"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/OptiViewAdsConfig/pdtGraceSeconds":{"identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig\/pdtGraceSeconds","type":"topic","title":"pdtGraceSeconds","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","