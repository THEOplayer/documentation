ce and the clock","type":"text"},{"text":" ","type":"text"},{"text":"takes over immediately, so a join-in-progress break is not delayed below the","type":"text"},{"text":" ","type":"text"},{"text":"tune-in minimum), or this window elapses (the backstop for a player that never","type":"text"},{"text":" ","type":"text"},{"text":"starts).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Set ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" to fall back to the system clock immediately. Has no effect on","type":"text"},{"text":" ","type":"text"},{"code":"pts","type":"codeVoice"},{"text":"-timebase manifests. Mirrors the web ","type":"text"},{"code":"pdtGraceSeconds","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK","doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig"]]},"identifier":{"url":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig\/pdtGraceSeconds","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/optiviewadssdk\/optiviewadsconfig\/pdtgraceseconds"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","abstract":[{"text":"How long, in seconds, to wait for the stream’s ","type":"text"},{"type":"codeVoice","code":"EXT-X-PROGRAM-DATE-TIME"},{"text":" on a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"wallclock"},{"text":"-timebase session before concluding the stream carries none.","type":"text"}],"references":{"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/OptiViewAds":{"kind":"symbol","type":"topic","title":"OptiViewAds","role":"symbol","navigatorTitle":[{"text":"OptiViewAds","kind":"identifier"}],"identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAds","fragments":[{"text":"class","ki