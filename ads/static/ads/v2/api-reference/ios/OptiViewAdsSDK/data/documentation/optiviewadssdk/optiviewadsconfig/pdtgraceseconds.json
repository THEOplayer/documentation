,{"inlineContent":[{"type":"text","text":"backstop, not a fixed delay"}],"type":"strong"},{"type":"text","text":". The SDK stops waiting at whichever"},{"type":"text","text":" "},{"type":"text","text":"comes first: content has been playing for ~1s and still exposes no PDT (direct"},{"type":"text","text":" "},{"type":"text","text":"evidence about the stream — "},{"type":"codeVoice","code":"DA-PDT-MISSING"},{"type":"text","text":" is emitted once and the clock"},{"type":"text","text":" "},{"type":"text","text":"takes over immediately, so a join-in-progress break is not delayed below the"},{"type":"text","text":" "},{"type":"text","text":"tune-in minimum), or this window elapses (the backstop for a player that never"},{"type":"text","text":" "},{"type":"text","text":"starts)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to fall back to the system clock immediately. Has no effect on"},{"type":"text","text":" "},{"type":"codeVoice","code":"pts"},{"type":"text","text":"-timebase manifests. Mirrors the web "},{"type":"codeVoice","code":"pdtGraceSeconds"},{"type":"text","text":"."}]}]}],"metadata":{"title":"pdtGraceSeconds","modules":[{"name":"OptiViewAdsSDK"}],"externalID":"s:14OptiViewAdsSDK0abC6ConfigV15pdtGraceSecondsSdvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdtGraceSeconds","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol"},"sections":[],"references":{"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK":{"url":"\/documentation\/optiviewadssdk","type":"topic","title":"OptiViewAdsSDK","identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK","abstract":[{"type":"text","text":"The player-agnostic orchestration layer of the OptiView Ads SDK: the "},{