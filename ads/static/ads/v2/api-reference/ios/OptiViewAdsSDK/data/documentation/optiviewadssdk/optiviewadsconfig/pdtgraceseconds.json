type":"text"},{"text":"carry it. Those ticks make no scheduling decision, rather than matching breaks","type":"text"},{"text":" ","type":"text"},{"text":"against the system clock — which runs ahead of the live playhead by the","type":"text"},{"text":" ","type":"text"},{"text":"stream’s latency and would fire a break early (PLAYG-360).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a "},{"type":"strong","inlineContent":[{"type":"text","text":"backstop, not a fixed delay"}]},{"type":"text","text":". The SDK stops waiting at whichever"},{"type":"text","text":" "},{"type":"text","text":"comes first: content has been playing for ~1s and still exposes no PDT (direct"},{"type":"text","text":" "},{"type":"text","text":"evidence about the stream — "},{"type":"codeVoice","code":"DA-PDT-MISSING"},{"type":"text","text":" is emitted once and the clock"},{"type":"text","text":" "},{"type":"text","text":"takes over immediately, so a join-in-progress break is not delayed below the"},{"type":"text","text":" "},{"type":"text","text":"tune-in minimum), or this window elapses (the backstop for a player that never"},{"type":"text","text":" "},{"type":"text","text":"starts)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"code":"0","type":"codeVoice"},{"type":"text","text":" to fall back to the system clock immediately. Has no effect on"},{"type":"text","text":" "},{"code":"pts","type":"codeVoice"},{"type":"text","text":"-timebase manifests. Mirrors the web "},{"code":"pdtGraceSeconds","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/OptiViewAdsConfig/pdtGraceSeconds":{"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"pdtGraceSeconds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"url":"\/documentation\/optiv