{"abstract":[{"type":"text","text":"How long, in seconds, to wait for the stream’s "},{"type":"codeVoice","code":"EXT-X-PROGRAM-DATE-TIME"},{"type":"text","text":" on a"},{"type":"text","text":" "},{"type":"codeVoice","code":"wallclock"},{"type":"text","text":"-timebase session before concluding the stream carries none."}],"hierarchy":{"paths":[["doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK","doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig"]]},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdtGraceSeconds","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"role":"symbol","symbolKind":"property","title":"pdtGraceSeconds","modules":[{"name":"OptiViewAdsSDK"}],"roleHeading":"Instance Property","externalID":"s:14OptiViewAdsSDK0abC6ConfigV15pdtGraceSecondsSdvp"},"identifier":{"url":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/documentation\/OptiViewAdsSDK\/OptiViewAdsConfig\/pdtGraceSeconds","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadssdk\/optiviewadsconfig\/pdtgraceseconds"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdtGraceSeconds","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A session is normally started before the content player has loaded its"},{"type":"text","text":" "},{"type":"text","text":"source, so the scheduler’s first ticks see no PDT even on a stream that does"},{"type":"text","text":" "},{"type":"text","text":"carry it. Those ticks make no scheduling decision, rather than matching breaks"},{"type":"text","text":" "},{"type":"text","text":"against the system clock — which runs ahead of the live playhead by the"},{"type":"text","text":" "},{"type":"text","text":"stream’s latency and would fire a break early (PLAYG-360)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a "},{"type":"strong","inlineContent":[{"text":"backstop, not a fixed delay","type":"text"}]},{"type":"text","text":". The SDK stops waiting at whichever"},{"type":"text","text":" "},{"type":"text","text":"comes first: content has been playing for ~1s and still exposes no PDT (direct"},{"type":"text","text":" "},{"type":"text","text":"evidence about the stream — "},{"type":"codeVoice","code":"DA-PDT-MISSING"},{"type":"text","text":" is emitted once and the clock"},{"type":"text","text":" "},{"type":"text","text":"takes over immediately, so a join-in-progress break is not delayed below the"},{"type":"text","text":" "},{"type":"text","text":"tune-in minimum), or this window elapses (the backstop for a player that never"},{"type":"text","text":" "},{"type":"text","text":"starts)."}]},{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to fall back to the system clock immediately. Has no effect on"},{"type":"text","text":" "},{"type":"codeVoice","code":"pts"},{"type":"text","text":"-timebase manifests. Mirrors the web "},{"type":"codeVoice","code":"pdtGraceSeconds"},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://optiviewadssdk.OptiViewAdsSDK/documentation/OptiViewAdsSDK/OptiViewAdsConfig":{"url":"\/documentation\/optiviewadssdk\/optiviewadsconfig","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OptiViewAdsConfig"}],"role":"symbol","identifier":"doc:\/\/optiviewadssdk.OptiViewAdsSDK\/d