e an integrator’s choice is populated from the"},{"type":"text","text":" "},{"type":"text","text":"playlist’s hold-back."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Defaulted to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for the same reason as "},{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/supportsParallelBuffering","isActive":true,"type":"reference"},{"type":"text","text":": this"},{"type":"text","text":" "},{"type":"text","text":"protocol is public and Swift has no optional members, so an integrator’s own"},{"type":"text","text":" "},{"type":"text","text":"adapter must keep compiling."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/maxLiveSeekPosition-198sh","interfaceLanguage":"swift"},"abstract":[{"text":"The furthest position on this player’s timeline a seek will actually STICK on live","type":"text"},{"text":" ","type":"text"},{"text":"content, in seconds — the engine pulls back anything closer to the live edge.","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when it cannot say, and on non-live content.","type":"text"}],"metadata":{"role":"symbol","symbolKind":"property","extendedModule":"OptiViewAdsCore","externalID":"s:15OptiViewAdsCore13PlayerAdapterPAAE19maxLiveSeekPositionSdSgvp","title":"maxLiveSeekPosition","modules":[{"name":"OptiViewAdsCore"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxLiveSeekPosition","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?","kind":"text