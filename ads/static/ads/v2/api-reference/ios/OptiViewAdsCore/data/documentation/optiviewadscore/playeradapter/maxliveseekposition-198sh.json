"text":" that looks like an integrator’s choice is populated from the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"playlist’s hold-back."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaulted to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for the same reason as "},{"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/supportsParallelBuffering","isActive":true},{"type":"text","text":": this"},{"type":"text","text":" "},{"type":"text","text":"protocol is public and Swift has no optional members, so an integrator’s own"},{"type":"text","text":" "},{"type":"text","text":"adapter must keep compiling."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/maxLiveSeekPosition-198sh"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"abstract":[{"type":"text","text":"The furthest position on this player’s timeline a seek will actually STICK on live"},{"type":"text","text":" "},{"type":"text","text":"content, in seconds — the engine pulls back anything closer to the live edge."},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when it cannot say, and on non-live content."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/playeradapter\/maxliveseekposition-198sh"]}],"metadata":{"title":"maxLiveSeekPosition","roleHeading":"Instance Property","externalID":"s:15OptiViewAdsCore13PlayerAdapterPAAE19maxLiveSeekPositionSdSgvp","role":"symbol","modules":[{"name":"OptiViewAdsCore"}],"extendedModule":"OptiViewAdsCore","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"te