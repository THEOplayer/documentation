{"abstract":[{"text":"Install the single observer for presentation-mode changes. The handler","type":"text"},{"text":" ","type":"text"},{"text":"receives ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the window opens and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when it closes,","type":"text"},{"text":" ","type":"text"},{"text":"whoever drove the transition. Installing replaces any previous handler.","type":"text"}],"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" ("},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The adapter MUST also invoke the handler once, synchronously or on the","type":"text"},{"text":" ","type":"text"},{"text":"next main-queue turn, with the CURRENT state at install time. The","type":"text"},{"text":" ","type":"text"},{"text":"adapter outlives the SDK session (one player, many sessions), so a","type":"text"},{"text":" ","type":"text"},{"text":"transition that lands between sessions — the previous session’s window","type":"text"},{"text":" ","type":"text"},{"text":"closing late, the next one not yet initialized — is otherwise consumed","type":"text"},{"text":" ","type":"text"},{"text":"by the adapter’s own change-dedup with nobody listening, and the new","type":"text"},{"text":" ","type":"text"},{"text":"session starts believing the window is closed while the player is","type":"text"},{"text":" ","type":"text"},{"text":"presenting in it (measured on the iOS e2e fleet, catalog-pip","type":"text"},{"text":" ","type":"text"},{"text":"PIP-ENTER-DURING-* @ 0.50.0-beta.506). The renderer’s dedup makes the","type":"text"},{"text":" ","type":"text"},{"text":"install-time delivery idempotent, so adapters need not special-case","type":"text"},{"text":" ","type":"text"},{"text":"“nothing changed”.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(_:)"]}],"metadata":{"symbolKind":"method","required":true,"role":"symbol","title":"onPictureInPictureChange(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")","kind":"text"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP02onefE6ChangeyyySbcF","roleHeading":"Instance Method","modules":[{"name":"OptiViewAdsCore"}]},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","url":"\/documentation\/optiviewadscore","title":"OptiViewAdsCore","kind":"symbol","type":"topic"