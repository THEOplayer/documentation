{"abstract":[{"text":"Install the single observer for presentation-mode changes. The handler","type":"text"},{"text":" ","type":"text"},{"text":"receives ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the window opens and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when it closes,","type":"text"},{"text":" ","type":"text"},{"text":"whoever drove the transition. Installing replaces any previous handler.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"((","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")","kind":"text"}],"required":true,"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:15OptiViewAdsCore09PictureInE7CapableP02onefE6ChangeyyySbcF","title":"onPictureInPictureChange(_:)","role":"symbol","modules":[{"name":"OptiViewAdsCore"}]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The adapter MUST also invoke the handler once, synchronously or on the","type":"text"},{"text":" ","type":"text"},{"text":"next main-queue turn, with the CURRENT state at install time. The","type":"text"},{"text":" ","type":"text"},{"text":"adapter outlives the SDK session (one player, many sessions), so a","type":"text"},{"text":" ","type":"text"},{"text":"transition that lands between sessions — the previous session’s window","type":"text"},{"text":" ","type":"text"},{"text":"closing late, the next one not yet initialized — is otherwise consumed","type":"text"},{"text":" ","type":"text"},{"text":"by the adapter’s own change-dedup with nobody listening, and the new","type":"text"},{"text":" ","type":"text"},{"text":"session starts believing the window is closed while the player is","type":"text"},{"text":" ","type":"text"},{"text":"presenting in it (measured on the iOS e2e fleet, catalog-pip","type":"text"},{"text":" ","type":"text"},{"text":"PIP-ENTER-DURING-* @ 0.50.0-beta.506). The renderer’s dedup makes the","type":"text"},{"text":" ","type":"text"},{"text":"install-time delivery idempotent, so adapters need not special-case","type":"text"},{"text":" ","type":"text"},{"text":"“nothing changed”.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"abstract":[{"type":"text","text":"The abstraction layer between the SDK and any content player — the Swift"},{"type":"text","text":" "},{"type":"