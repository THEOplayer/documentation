xt":"“nothing changed”.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Install the single observer for presentation-mode changes. The handler"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the window opens and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when it closes,"},{"type":"text","text":" "},{"type":"text","text":"whoever drove the transition. Installing replaces any previous handler."}],"variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)"},"metadata":{"modules":[{"name":"OptiViewAdsCore"}],"title":"onPictureInPictureChange(_:)","required":true,"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"(("},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP02onefE6ChangeyyySbcF","role":"symbol","roleHeading":"Instance Method"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/onPictureInPictureChange(_:)":{"type":"topic","required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"id