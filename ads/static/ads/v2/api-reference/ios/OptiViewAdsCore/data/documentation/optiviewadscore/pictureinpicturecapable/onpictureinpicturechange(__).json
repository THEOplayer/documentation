{"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"(("},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")"}],"role":"symbol","roleHeading":"Instance Method","externalID":"s:15OptiViewAdsCore09PictureInE7CapableP02onefE6ChangeyyySbcF","title":"onPictureInPictureChange(_:)","modules":[{"name":"OptiViewAdsCore"}],"required":true,"symbolKind":"method"},"abstract":[{"type":"text","text":"Install the single observer for presentation-mode changes. The handler"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the window opens and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when it closes,"},{"type":"text","text":" "},{"type":"text","text":"whoever drove the transition. Installing replaces any previous handler."}],"kind":"symbol","variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" ("},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["iOS"]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The adapter MUST also invoke the handler once, synchronously or on the","type":"text"},{"text":" ","type":"text"},{"text":"next main-queue turn, with the CURRENT state at install time. The","type":"text"},{"text":" ","type":"text"},{"text":"adapter outlives the SDK session (one player, many sessions), so a","type":"text"},{"text":" ","type":"text"},{"text":"transition that lands between sessions — the previous session’s window","type":"text"},{"text":" ","type":"text"},{"text":"closing late, the next one not yet initialized — is otherwise consumed","type":"text"},{"text":" ","type":"text"},{"text":"by the adapter’s own change-dedup with nobody listening, and the new","type":"text"},{"text":" ","type":"text"},{"text":"session starts believing the window is closed while the player is","type":"text"},{"text":" ","type":"text"},{"text":"presenting in it (measured on the iOS e2e fleet, catalog-pip","type":"text"},{"text":" ","type":"text"},{"text":"PIP-ENTER-DURING-* @ 0.50.0-beta.506). The renderer’s dedup makes the","type":"text"},{"text":" ","type":"text"},{"text":"install-time delivery idempotent, so adapters need not special-case","type":"text"},{"text":" ","type":"text"},{"text":"“nothing changed”.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"url":"\/documentation\/optiviewadscore\/playeradapter","abstract":[{"text":"The abstraction layer between the SDK and any content player — the Swift","type":"text"},{"text":" ","type":"text"},{"text":"mirror of the Kotlin ","type":"text"},{"code":"PlayerAdapter","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","role":"symbol","title":"PlayerAdapter","navigatorTitle":[{"kind":"identifier","text":"PlayerAdapter"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerAdapter"}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","role":"collection","url":"\/documentation\/optiviewadscore","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}],"title":"OptiViewAdsCore"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable":{"kind":"symbol","title":"PictureInPictureCapable","role":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}],"abstract":[{"type":"text","text":"Optional capability a "},{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"reference","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}]},"doc://optiviewadscore