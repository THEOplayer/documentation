d":"text","text":")"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The adapter MUST also invoke the handler once, synchronously or on the","type":"text"},{"text":" ","type":"text"},{"text":"next main-queue turn, with the CURRENT state at install time. The","type":"text"},{"text":" ","type":"text"},{"text":"adapter outlives the SDK session (one player, many sessions), so a","type":"text"},{"text":" ","type":"text"},{"text":"transition that lands between sessions — the previous session’s window","type":"text"},{"text":" ","type":"text"},{"text":"closing late, the next one not yet initialized — is otherwise consumed","type":"text"},{"text":" ","type":"text"},{"text":"by the adapter’s own change-dedup with nobody listening, and the new","type":"text"},{"type":"text","text":" "},{"type":"text","text":"session starts believing the window is closed while the player is"},{"type":"text","text":" "},{"type":"text","text":"presenting in it (measured on the iOS e2e fleet, catalog-pip"},{"type":"text","text":" "},{"type":"text","text":"PIP-ENTER-DURING-* @ 0.50.0-beta.506). The renderer’s dedup makes the"},{"type":"text","text":" "},{"type":"text","text":"install-time delivery idempotent, so adapters need not special-case"},{"type":"text","text":" "},{"type":"text","text":"“nothing changed”."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/onPictureInPictureChange(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":