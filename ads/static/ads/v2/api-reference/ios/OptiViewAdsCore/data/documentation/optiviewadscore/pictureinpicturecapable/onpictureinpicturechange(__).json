{"variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Install the single observer for presentation-mode changes. The handler"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the window opens and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when it closes,"},{"type":"text","text":" "},{"type":"text","text":"whoever drove the transition. Installing replaces any previous handler."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The adapter MUST also invoke the handler once, synchronously or on the","type":"text"},{"text":" ","type":"text"},{"text":"next main-queue turn, with the CURRENT state at install time. The","type":"text"},{"text":" ","type":"text"},{"text":"adapter outlives the SDK session (one player, many sessions), so a","type":"text"},{"text":" ","type":"text"},{"text":"transition that lands between sessions — the previous session’s window","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"closing late, the next one not yet initialized — is otherwise consumed"},{"type":"text","text":" "},{"type":"text","text":"by the adapter’s own change-dedup with nobody listening, and the new"},{"type":"text","text":" "},{"type":"text","text":"session starts believing the window is closed while the player is"},{"type":"text","text":" "},{"type":"text","text":"presenting in it (measured on the iOS e2e fleet, catalog-pip"},{"type":"text","text":" "},{"type":"text","text":"PIP-ENTER-DURING-* @ 0.50.0-beta.506). The renderer’s dedup makes the"},{"type":"text","text":" "},{"type":"text","text":"install-time delivery idempotent, so adapters need not special-case"},{"type":"text","text":" "},{"type":"text","text":"“nothing changed”."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"method","required":true,"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP02onefE6ChangeyyySbcF","title":"onPictureInPictureChange(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"(("},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"kind":"text","text":")"}]},"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","interfaceLanguage":"swift"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"url":"\/documentation\/optiviewadscore\/playeradapter","kind":"symbol","title":"PlayerAdapter","abstract":[{"text":"The abstraction layer between