{"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The adapter MUST also invoke the handler once, synchronously or on the"},{"type":"text","text":" "},{"type":"text","text":"next main-queue turn, with the CURRENT state at install time. The"},{"type":"text","text":" "},{"text":"adapter outlives the SDK session (one player, many sessions), so a","type":"text"},{"text":" ","type":"text"},{"text":"transition that lands between sessions — the previous session’s window","type":"text"},{"text":" ","type":"text"},{"text":"closing late, the next one not yet initialized — is otherwise consumed","type":"text"},{"text":" ","type":"text"},{"text":"by the adapter’s own change-dedup with nobody listening, and the new","type":"text"},{"text":" ","type":"text"},{"text":"session starts believing the window is closed while the player is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"presenting in it (measured on the iOS e2e fleet, catalog-pip"},{"type":"text","text":" "},{"type":"text","text":"PIP-ENTER-DURING-* @ 0.50.0-beta.506). The renderer’s dedup makes the"},{"type":"text","text":" "},{"type":"text","text":"install-time delivery idempotent, so adapters need not special-case"},{"type":"text","text":" "},{"type":"text","text":"“nothing changed”."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)"},"abstract":[{"type":"text","text":"Install the single observer for presentation-mode changes. The handler"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the window opens and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when it closes,"},{"type":"text","text":" "},{"type":"text","text":"whoever drove the transition. Installing replaces any previous handler."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"required":true,"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP02onefE6ChangeyyySbcF","modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"onPictureInPictureChange(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")"}]},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapter","kind":"identifier"}],"navigatorTitle":[{"tex