{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Install the single observer for presentation-mode changes. The handler","type":"text"},{"text":" ","type":"text"},{"text":"receives ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when the window opens and ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" when it closes,","type":"text"},{"text":" ","type":"text"},{"text":"whoever drove the transition. Installing replaces any previous handler.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The adapter MUST also invoke the handler once, synchronously or on the"},{"type":"text","text":" "},{"type":"text","text":"next main-queue turn, with the CURRENT state at install time. The"},{"type":"text","text":" "},{"type":"text","text":"adapter outlives the SDK session (one player, many sessions), so a"},{"type":"text","text":" "},{"type":"text","text":"transition that lands between sessions — the previous session’s window"},{"type":"text","text":" "},{"type":"text","text":"closing