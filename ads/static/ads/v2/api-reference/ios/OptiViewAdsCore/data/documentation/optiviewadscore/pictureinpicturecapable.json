{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Optional capability a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"topicSections":[{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"},{"kind":"text","text":" : AnyObject"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime’s default is to drive "},{"type":"codeVoice","code":"AVPictureInPictureController"},{"type":"text","text":" against the"},{"type":"text","text":" "},{"type":"text","text":"content "},{"type":"codeVoice","code":"AVPlayerLayer"},{"type":"text","text":" it discovers in the integrator’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"That works for players that keep one layer alive across source changes"},{"type":"text","text":" "},{"type":"text","text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for"},{"type":"text","text":" "},{"type":"text","text":"players that rebuild their internal pipeline on a source change: THEOplayer"},{"type":"text","text":" "},{"type":"text","text":"replaces its internal AVPlayer\/layer when "},{"type":"codeVoice","code":"source"},{"type":"text","text":" is assigned, the"},{"type":"text","text":" "},{"type":"text","text":"discovered layer dies, and AVKit closes the window at the exact moment the"},{"type":"text","text":" "},{"type":"text","text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet"},{"type":"text","text":" "},{"type":"text","text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and"},{"type":"text","text":" "},{"type":"text","text":"closed at "},{"type":"codeVoice","code":"adbreakbegin"},{"type":"text","text":", with the ad playing full-screen in the main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}]},{"type":"paragraph","inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"piece — THEOplayer retains the window across source changes when the host"},{"type":"text","text":" "},{"type":"text","text":"constructs it with "},{"type":"codeVoice","code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)"},{"type":"text","text":" — but only if the window is driven through THAT facility. This"},{"type":"text","text":" "},{"type":"text","text":"protocol is how an adapter hands the SDK that steering wheel; the renderer"},{"type":"text","text":" "},{"type":"text","text":"prefers it over its own controller whenever the content adapter conforms."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"type":"text","text":"thread, for every transition — including viewer-driven ones (the system UI"},{"type":"text","text":" "},{"type":"text","text":"can dismiss the window at any time), which is the whole reason the handler"},{"type":"text","text":" "},{"type":"text","text":"exists: the break format follows what is actually on screen."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"sections":[],"metadata":{"title":"PictureInPictureCapable","navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","roleHeading":"Protocol","modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"protocol","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"seeAlsoSections":[{"anchor":"Player-contract","generated":true,"title":"Player contract","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"},"kind":"symbol","references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"role":"collection","url":"\/documentation\/optiviewadscore","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}],"kind":