{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"title":"PictureInPictureCapable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"}],"modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","roleHeading":"Protocol","role":"symbol"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"topicSections":[{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"]}],"abstract":[{"type":"text","text":"Optional capability a "},{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"reference","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"seeAlsoSections":[{"generated":true,"title":"Player contract","anchor":"Player-contract","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore