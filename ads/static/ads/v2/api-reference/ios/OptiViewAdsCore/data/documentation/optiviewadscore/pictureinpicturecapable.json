{"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"abstract":[{"text":"Optional capability a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"reference"},{"text":" implements when its player owns","type":"text"},{"text":" ","type":"text"},{"text":"picture-in-picture natively.","type":"text"}],"topicSections":[{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"anchor":"Instance-Methods"}],"kind":"symbol","seeAlsoSections":[{"title":"Player contract","generated":true,"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"],"anchor":"Player-contract"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"},"metadata":{"roleHeading":"Protocol","title":"PictureInPictureCapable","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"}],"navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","symbolKind":"protocol","modules":[{"name":"OptiViewAdsCore"}]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The runtime’s default is to drive "},{"type":"codeVoice","code":"AVPictureInPictureController"},{"type":"text","text":" against the"},{"type":"text","text":" "},{"type":"text","text":"content "},{"type":"codeVoice","code":"AVPlayerLayer"},{"type":"text","text":" it discovers in the integrator’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"That works for players that keep one layer alive across source changes"},{"type":"text","text":" "},{"type":"text","text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for"},{"type":"text","text":" "},{"type":"text","text":"players that rebuild their internal pipeline on a source change: THEOplayer"},{"type":"text","text":" "},{"type":"text","text":"replaces its internal AVPlayer\/layer when "},{"type":"codeVoice","code":"source"},{"type":"text","text":" is assigned, the"},{"type":"text","text":" "},{"type":"text","text":"discovered layer dies, and AVKit closes the window at the exact moment the"},{"type":"text","text":" "},{"type":"text","text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet"},{"type":"text","text":" "},{"type":"text","text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and"},{"type":"text","text":" "},{"type":"text","text":"closed at "},{"type":"codeVoice","code":"adbreakbegin"},{"type":"text","text":", with the ad playing full-screen in the main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Such players expose their own picture-in-picture facility with the missing"},{"type":"text","text":" "},{"type":"text","text":"piece — THEOplayer retains the window across source changes when the host"},{"type":"text","text":" "},{"type":"text","text":"constructs it with "},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"type":"text","text":" — but only if the window is driven through THAT facility. This"},{"type":"text","text":" "},{"type":"text","text":"protocol is how an adapter hands the SDK that steering wheel; the renderer"},{"type":"text","text":" "},{"type":"text","text":"prefers it over its own controller whenever the content adapter conforms."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"text":"thread, for every transition — including viewer-driven ones (the system UI","type":"text"},{"text":" ","type":"text"},{"text":"can dismiss the window at any time), which is the whole reason the handler","type":"text"},{"text":" ","type":"text"},{"text":"exists: the break format follows what is actually on screen.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"title":"OptiViewAdsCore","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","url":"\/documentation\/optiviewadscore","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/isPictureInPicture()":{"required":true,"type":"topic","title":"isPictureInPicture()","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isPictureInPicture"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether the player is presenting in picture-in-picture right now —","type":"text"},{"text":" ","type":"text"},{"text":"read from the player, not from the last request.","type":"text"}],"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable\/ispictureinpicture()","role":"symbol","kind":"symbol"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/ContentVideoSizeProvider":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentVideoSizeProvider"}],"navigatorTitle":[{"kind":"identifier","text":"ContentVideoSizeProvider"}],"url":"\/documentation\/optiviewadscore\/contentvideosizeprovider","type":"topic","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider","kind":"symbol","abstract":[{"text":"Optional capability for reporting the content video’s intrinsic dimensions.","type":"text"}],"title":"ContentVideoSizeProvider"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/setPictureInPicture(_:)":{"title":"setPictureInPicture(_:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setPictureInPicture","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable\/setpictureinpicture(__)","abstract":[{"type":"text","text":"Ask the player to enter ("},{"type":"codeVoice","code":"true"},{"type":"text","text":") or leave ("},{"type":"codeVoice","code":"false"},{"type":"text","text":") picture-in-picture."},{"type":"text","text":" "},{"type":"text","text":"Best-effort, like every PiP transition on iOS: the outcome is reported"},{"type":"text","text":" "},{"type":"text","text":"through the change handler, never assumed from the request."}],"required":true,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)","kind":"symbol"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable":{"title":"PictureInPictureCapable","type":"topic","url":"\/documentation\/optiviewadscore\/pictureinpicturecapable","navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}],"abstract":[{"text":"Optional capability a ","type":"text"},{"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","isActive":true},{"text":" implements when its player owns","type":"text"},{"text":" ","type":"text"},{"text":"picture-in-picture natively.","type":"text"}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/TimedMetadataCue":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedMetadataCue","kind":"identifier"}],"url":"\/documentation\/optiviewadscore\/timedmetadatacue","kind":"symbol","navigatorTitle":[{"text":"TimedMetadataCue","kind":"identifier"}],"abstract":[{"type":"text","text":"A single in-stream timed-metadata marker surfaced by a content player — the"},{"type":"text","text":" "},{"type":"text","text":"Swift mirror of the TS "},{"type":"codeVoice","code":"TimedMetadataCue"},{"type":"text","text":". Carried as the payload of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"timedmetadata"},{"type":"text","text":" event; in SSAI mode the SDK forwards it to the IMA DAI stream"},{"type":"text","text":" "},{"type":"text","text":"manager for ad tracking."}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","type":"topic","role":"symbol","title":"TimedMetadataCue"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/onPictureInPictureChange(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")","kind":"text"}],"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(__)","kind":"symbol","abstract":[{"type":"text","text":"Install the single observer for presentation-mode changes. The handler"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the window opens and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when it closes,"},{"type":"text","text":" "},{"type":"text","text":"whoever drove the transition. Installing replaces any previous handler."}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","required":true,"type":"topic",