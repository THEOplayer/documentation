:"text","text":") picture-in-picture."},{"type":"text","text":" "},{"type":"text","text":"Best-effort, like every PiP transition on iOS: the outcome is reported"},{"type":"text","text":" "},{"type":"text","text":"through the change handler, never assumed from the request."}],"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable\/setpictureinpicture(__)","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)","required":true,"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setPictureInPicture","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"topic","abstract":[{"type":"text","text":"The abstraction layer between the SDK and any content player — the Swift"},{"type":"text","text":" "},{"text":"mirror of the Kotlin ","type":"text"},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":"."}],"url":"\/documentation\/optiviewadscore\/playeradapter","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapter","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PlayerAdapter"}],"title":"PlayerAdapter","role":"symbol","kind":"symbol"}}}