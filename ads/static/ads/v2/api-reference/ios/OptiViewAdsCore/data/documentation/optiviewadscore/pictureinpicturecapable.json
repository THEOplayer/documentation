{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Instance-Methods","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"title":"Instance Methods","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"},"seeAlsoSections":[{"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"],"anchor":"Player-contract","title":"Player contract","generated":true}],"abstract":[{"type":"text","text":"Optional capability a "},{"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}],"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","modules":[{"name":"OptiViewAdsCore"}],"roleHeading":"Protocol","role":"symbol","title":"PictureInPictureCapable"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"},{"kind":"text","text":" : AnyObject"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The runtime’s default is to drive ","type":"text"},{"code":"AVPictureInPictureController","type":"codeVoice"},{"text":" against the","type":"text"},{"text":" ","type":"text"},{"text":"content ","type":"text"},{"code":"AVPlayerLayer","type":"codeVoice"},{"text":" it discovers in the integrator’s view hierarchy.","type":"text"},{"text":" ","type":"text"},{"text":"That works for players that keep one layer alive across source changes","type":"text"},{"text":" ","type":"text"},{"text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for","type":"text"},{"text":" ","type":"text"},{"text":"players that rebuild their internal pipeline on a source change: THEOplayer","type":"text"},{"text":" ","type":"text"},{"text":"replaces its internal AVPlayer\/layer when ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is assigned, the","type":"text"},{"text":" ","type":"text"},{"text":"discovered layer dies, and AVKit closes the window at the exact moment the","type":"text"},{"text":" ","type":"text"},{"text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet","type":"text"},{"text":" ","type":"text"},{"text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and","type":"text"},{"text":" ","type":"text"},{"text":"closed at ","type":"text"},{"code":"adbreakbegin","type":"codeVoice"},{"text":", with the ad playing full-screen in the main","type":"text"},{"text":" ","type":"text"},{"text":"window instead of inside it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Such players expose their own picture-in-picture facility with the missing"},{"type":"text","text":" "},{"type":"text","text":"piece — THEOplayer retains the window across source changes when the host"},{"type":"text","text":" "},{"type":"text","text":"constructs it with "},{"type":"codeVoice","code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)"},{"type":"text","text":" — but only if the window is driven through THAT facility. This"},{"type":"text","text":" "},{"type":"text","text":"protocol is how an adapter hands the SDK that steering wheel; the renderer"},{"type":"text","text":" "},{"type":"text","text":"prefers it over its own controller whenever the content adapter conforms."}]},{"type":"paragraph","inlineContent":[{"text":"All three members are called on the main thread (the renderer is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":"); the change handler must likewise be invoked on the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, for every transition — including viewer-driven ones (the system UI","type":"text"},{"text":" ","type":"text"},{"text":"can dismiss the window at any time), which is the whole reason the handler","type":"text"},{"text":" ","type":"text"},{"text":"exists: the break format follows what is actually on screen.","type":"text"}]}],"kind":"content"}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"abstract":[{"type":"text","text":"The abstraction layer between the SDK and any content player — the Swift"},{"type":"text","text":" "},{"type":"text","text":"mirror of the Kotlin "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":"."}],"title":"PlayerAdapter","kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapter","kind":"identifier"}],"navigatorTitle":[{"text":"PlayerAdapter","kind":"identifier"}],"url":"\/documentation\/optiviewadscore\/playeradapter","type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/TimedMetadataCue":{"role":"symbol","url":"\/documentation\/optiviewadscore\/timedmetadatacue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedMetadataCue","kind":"identifier"}],"abstract":[{"type":"text","text":"A single in-stream timed-metadata marker surfaced by a content player — the"},{"type":"text","text":" "},{"type":"text","text":"Swift mirror of the TS "},{"type":"codeVoice","code":"TimedMetadataCue"},{"type":"text","text":". Carried as the payload of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"timedmetadata"},{"type":"text","text":" event; in SSAI mode the SDK forwards it to the IMA DAI stream"},{"type":"text","text":" "},{"text":"manager for ad tracking.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"TimedMetadataCue","kind":"identifier"}],"kind":"symbol","title":"TimedMetadataCue","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/onPictureInPictureChange(_:)":{"type":"topic","required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onPictureInPictureChange"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")"}],"title":"onPictureInPictureChange(_:)","url":"\/documentation\/optiviewadscore\/pictureinpicturecapable\/onpictureinpicturechange(