{"sections":[],"abstract":[{"text":"Optional capability a ","type":"text"},{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","isActive":true,"type":"reference"},{"text":" implements when its player owns","type":"text"},{"text":" ","type":"text"},{"text":"picture-in-picture natively.","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Player-contract","title":"Player contract","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The runtime’s default is to drive ","type":"text"},{"type":"codeVoice","code":"AVPictureInPictureController"},{"text":" against the","type":"text"},{"text":" ","type":"text"},{"text":"content ","type":"text"},{"type":"codeVoice","code":"AVPlayerLayer"},{"text":" it discovers in the integrator’s view hierarchy.","type":"text"},{"text":" ","type":"text"},{"text":"That works for players that keep one layer alive across source changes","type":"text"},{"text":" ","type":"text"},{"text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for","type":"text"},{"text":" ","type":"text"},{"text":"players that rebuild their internal pipeline on a source change: THEOplayer","type":"text"},{"text":" ","type":"text"},{"text":"replaces its internal AVPlayer\/layer when ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is assigned, the","type":"text"},{"text":" ","type":"text"},{"text":"discovered layer dies, and AVKit closes the window at the exact moment the","type":"text"},{"text":" ","type":"text"},{"text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet","type":"text"},{"text":" ","type":"text"},{"text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and","type":"text"},{"text":" ","type":"text"},{"text":"closed at ","type":"text"},{"code":"adbreakbegin","type":"codeVoice"},{"text":", with the ad playing full-screen in the main","type":"text"},{"text":" ","type":"text"},{"text":"window instead of inside it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"text":" ","type":"text"},{"text":"piece — THEOplayer retains the window across source changes when the host","type":"text"},{"text":" ","type":"text"},{"text":"constructs it with ","type":"text"},{"type":"codeVoice","code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)"},{"text":" — but only if the window is driven through THAT facility. This","type":"text"},{"text":" ","type":"text"},{"text":"protocol is how an adapter hands the SDK that steering wheel; the renderer","type":"text"},{"text":" ","type":"text"},{"text":"prefers it over its own controller whenever the content adapter conforms.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"All three members are called on the main thread (the renderer is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":"); the change handler must likewise be invoked on the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, for every transition — including viewer-driven ones (the system UI","type":"text"},{"text":" ","type":"text"},{"text":"can dismiss the window at any time), which is the whole reason the handler","type":"text"},{"text":" ","type":"text"},{"text":"exists: the break format follows what is actually on screen.","type":"text"}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"metadata":{"roleHeading":"Protocol","role":"symbol","symbolKind":"protocol","title":"PictureInPictureCapable","externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"modules":[{"name":"OptiViewAdsCore"}]},"topicSections":[{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/onPictureInPictureChange(_:)":{"required":true,"abstract":[{"text":"Install the single observer for presentation-mode changes. The handler","type":"text"},{"text":" ","type":"text"},{"text":"receives ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when the window opens and ","type":"text"},{"type":"codeVoice","code":"false"},{"