{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"],"generated":true,"anchor":"Player-contract","title":"Player contract"}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"abstract":[{"type":"text","text":"Optional capability a "},{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"reference","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"metadata":{"symbolKind":"protocol","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"}],"role":"symbol","externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}],"modules":[{"name":"OptiViewAdsCore"}],"title":"PictureInPictureCapable"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"},{"kind":"text","text":" : AnyObject"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"The runtime’s default is to drive "},{"type":"codeVoice","code":"AVPictureInPictureController"},{"type":"text","text":" against the"},{"type":"text","text":" "},{"type":"text","text":"content "},{"type":"codeVoice","code":"AVPlayerLayer"},{"type":"text","text":" it discovers in the integrator’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"That works for players that keep one layer alive across source changes"},{"type":"text","text":" "},{"type":"text","text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for"},{"type":"text","text":" "},{"type":"text","text":"players that rebuild their internal pipeline on a source change: THEOplayer"},{"type":"text","text":" "},{"type":"text","text":"replaces its internal AVPlayer\/layer when "},{"type":"codeVoice","code":"source"},{"type":"text","text":" is assigned, the"},{"type":"text","text":" "},{"type":"text","text":"discovered layer dies, and AVKit closes the window at the exact moment the"},{"type":"text","text":" "},{"type":"text","text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet"},{"type":"text","text":" "},{"type":"text","text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and"},{"type":"text","text":" "},{"type":"text","text":"closed at "},{"type":"codeVoice","code":"adbreakbegin"},{"type":"text","text":", with the ad playing full-screen in the main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}],"type":"paragraph"},{"inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"text":" ","type":"text"},{"text":"piece — THEOplayer retains the window across source changes when the host","type":"text"},{"text":" ","type":"text"},{"text":"constructs it with ","type":"text"},{"type":"codeVoice","code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)"},{"text":" — but only if the window is driven through THAT facility. This","type":"text"},{"text":" ","type":"text"},{"text":"protocol is how an adapter hands the SDK that steering wheel; the renderer","type":"text"},{"text":" ","type":"text"},{"text":"prefers it over its own controller whenever the content adapter conforms.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"type":"text","text":"thread, for every transition — including viewer-driven ones (the system UI"},{"type":"text","text":" "},{"type":"text","text":"can dismiss the window at any time), which is the whole reason the handler"},{"type":"text","text":" "},{"type":"text","text":"exists: the break format follows what is actually on screen."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","url":"\/documentation\/optiviewadscore","title":"OptiViewAdsCore","kind":"symbol","type":"topic","abstract":[{"text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the","type":"text"},{"text":" ","type":"text"},{"code":"PlayerAdapter","type":"codeVoice"},{"tex