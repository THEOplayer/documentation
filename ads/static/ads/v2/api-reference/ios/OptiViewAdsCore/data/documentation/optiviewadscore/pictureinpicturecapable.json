{"metadata":{"roleHeading":"Protocol","modules":[{"name":"OptiViewAdsCore"}],"navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}],"symbolKind":"protocol","title":"PictureInPictureCapable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"generated":true}],"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"abstract":[{"type":"text","text":"Optional capability a "},{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"reference","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"kind":"symbol","seeAlsoSections":[{"title":"Player contract","anchor":"Player-contract","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"},{"kind":"text","text":" : AnyObject"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"The runtime’s default is to drive "},{"code":"AVPictureInPictureController","type":"codeVoice"},{"type":"text","text":" against the"},{"type":"text","text":" "},{"type":"text","text":"content "},{"code":"AVPlayerLayer","type":"codeVoice"},{"type":"text","text":" it discovers in the integrator’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"That works for players that keep one layer alive across source changes"},{"type":"text","text":" "},{"type":"text","text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for"},{"type":"text","text":" "},{"type":"text","text":"players that rebuild their internal pipeline on a source change: THEOplayer"},{"type":"text","text":" "},{"type":"text","text":"replaces its internal AVPlayer\/layer when "},{"code":"source","type":"codeVoice"},{"type":"text","text":" is assigned, the"},{"type":"text","text":" "},{"type":"text","text":"discovered layer dies, and AVKit closes the window at the exact moment the"},{"type":"text","text":" "},{"type":"text","text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet"},{"type":"text","text":" "},{"type":"text","text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and"},{"type":"text","text":" "},{"type":"text","text":"closed at "},{"code":"adbreakbegin","type":"codeVoice"},{"type":"text","text":", with the ad playing full-screen in the main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Such players expose their own picture-in-picture facility with the missing"},{"type":"text","text":" "},{"type":"text","text":"piece — THEOplayer retains the window across source changes when the host"},{"type":"text","text":" "},{"type":"text","text":"constructs it with "},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"type":"text","text":" — but only if the window is driven through THAT facility. This"},{"type":"text","text":" "},{"type":"text","text":"protocol is how an adapter hands the SDK that steering wheel; the renderer"},{"type":"text","text":" "},{"type":"text","text":"prefers it over its own controller whenever the content adapter conforms."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"type":"text","text":"thread, for every transition — including viewer-driven ones (the system UI"},{"type":"text","text":" "},{"type":"text","text":"can dismiss the window at any time), which is the whole reason the handler"},{"type":"text","text":" "},{"type":"text","text":"exists: the break format follows what is actually on screen."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/ContentVideoSizeProvider":{"type":"topic","url":"\/documentation\/optiviewadscore\/contentvideosizeprovider","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider","abstract":[{"text":"Optional capability for reporting the content video’s intrinsic dimensions.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ContentVideoSizeProvider"}],"title":"ContentVideoSizeProvider","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentVideoSizeProvider"}],"role":"symbol"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapterEvent":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","kind":"symbol","url":"\/documentation\/optiviewadscore\/playeradapterevent","role":"symbol","title":"PlayerAdapterEvent","navigatorTitle":[{"text":"PlayerAdapterEvent","kind":"identifier"}],"abstract":[{"type":"text","text":"Event types a "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" forwards (mirrors the Kotlin "},{"type":"codeVoice","code":"PlayerAdapterEvent"},{"type":"text","text":")."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapterEvent","kind":"identifier"}],"type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"type":"topic","url":"\/documentation\/optiviewadscore","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}],"title":"OptiViewAdsCore","kind":"symbol","role":"collection"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The abstraction layer between the SDK and any content player — the Swift"},{"type":"text","text":" "},{"type":"text","text":"mirror of the Kotlin "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"Pl