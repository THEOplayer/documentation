he main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"text":" ","type":"text"},{"text":"piece — THEOplayer retains the window across source changes when the host","type":"text"},{"text":" ","type":"text"},{"text":"constructs it with ","type":"text"},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"type":"text","text":" — but only if the window is driven through THAT facility. This"},{"type":"text","text":" "},{"type":"text","text":"protocol is how an adapter hands the SDK that steering wheel; the renderer"},{"type":"text","text":" "},{"type":"text","text":"prefers it over its own controller whenever the content adapter conforms."}]},{"type":"paragraph","inlineContent":[{"text":"All three members are called on the main thread (the renderer is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":"); the change handler must likewise be invoked on the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, for every transition — including viewer-driven ones (the system UI","type":"text"},{"text":" ","type":"text"},{"text":"can dismiss the window at any time), which is the whole reason the handler","type":"text"},{"text":" ","type":"text"},{"text":"exists: the break format follows what is actually on screen.","type":"text"}]}],"kind":"content"}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/TimedMetadataCue":{"kind":"symbol","url":"\/documentation\/optiviewadscore\/timedmetadatacue","role":"symbol","type":"topic","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedMetadataCue"}],"abstract":[{"type":"text","text":"A single in-stream timed-metadata marker surfaced by a content player — the"},{"type":"text","text":" "},{"type":"text","text":"Swift mirror of the TS "},{"type":"codeVoice","code":"TimedMetadataCue"},{"text":". Carried as the payload of a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"timedmetadata"},{"type":"text","text":" event; in SSAI mode the SDK forwards it to the IMA DAI stream"},{"type":"text","text":" "},{"type":"text","text":"manager for ad tracking."}],"navigatorTitle":[{"kind":"identifier","text":"TimedMetadataCue"}],"title":"TimedMetadataCue"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/ContentVideoSizeProvider":{"title":"ContentVideoSizeProvider","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentVideoSizeProvider"}],"kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ContentVideoSizeProvider"}],"url":"\/documentation\/optiviewadscore\/contentvideosizeprovider","abstract":[{"text":"Optional capability for reporting the content video’s intrinsic dimensions.","type":"text"}],"role":"symbol"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable":{"title":"PictureInPictureCapable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}],"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable","abstract":[{"text":"Optional capability a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentatio