{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"]}],"abstract":[{"type":"text","text":"Optional capability a "},{"isActive":true,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","type":"reference"},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"generated":true,"anchor":"Player-contract","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"],"title":"Player contract"}],"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"metadata":{"roleHeading":"Protocol","role":"symbol","title":"PictureInPictureCapable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"}],"symbolKind":"protocol","modules":[{"name":"OptiViewAdsCore"}],"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}]},"kind":"symbol","identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"title":"Instance Methods"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The runtime’s default is to drive "},{"code":"AVPictureInPictureController","type":"codeVoice"},{"type":"text","text":" against the"},{"type":"text","text":" "},{"type":"text","text":"content "},{"code":"AVPlayerLayer","type":"codeVoice"},{"type":"text","text":" it discovers in the integrator’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"That works for players that keep one layer alive across source changes"},{"type":"text","text":" "},{"type":"text","text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for"},{"type":"text","text":" "},{"type":"text","text":"players that rebuild their internal pipeline on a source change: THEOplayer"},{"type":"text","text":" "},{"type":"text","text":"replaces its internal AVPlayer\/layer when "},{"code":"source","type":"codeVoice"},{"type":"text","text":" is assigned, the"},{"type":"text","text":" "},{"type":"text","text":"discovered layer dies, and AVKit closes the window at the exact moment the"},{"type":"text","text":" "},{"type":"text","text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet"},{"type":"text","text":" "},{"type":"text","text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and"},{"type":"text","text":" "},{"type":"text","text":"closed at "},{"code":"adbreakbegin","type":"codeVoice"},{"type":"text","text":", with the ad playing full-screen in the main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Such players expose their own picture-in-picture facility with the missing"},{"type":"text","text":" "},{"type":"text","text":"piece — THEOplayer retains the window across source changes when the host"},{"type":"text","text":" "},{"type":"text","text":"constructs it with "},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"type":"text","text":" — but only if the window is driven through THAT facility. This"},{"type":"text","text":" "},{"type":"text","text":"protocol is how an adapter hands the SDK that steering wheel; the renderer"},{"type":"text","text":" "},{"type":"text","text":"prefers it over its own controller whenever the content adapter conforms."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"type":"text","text":"thread, for every transition — including viewer-driven ones (the system UI"},{"type":"text","text":" "},{"type":"text","text":"can dismiss the window at any time), which is the whole reason the handler"},{"type":"text","text":" "},{"type":"text","text":"exists: the break format follows what is actually on screen."}],"type":"paragraph"}]}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapterEvent":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","type":"topic","abstract":[{"type":"text","text":"Event types a "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" forwards (mirrors the Kotlin "},{"type":"codeVoice","code":"PlayerAdapterEvent"},{"type":"text","text":")."}],"url":"\/documentation\/optiviewadscore\/playeradapterevent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapterEvent","kind":"identifier"}],"navigatorTitle":[{"text":"PlayerAdapterEvent","kind":"identifier"}],"title":"PlayerAdapterEvent","role":"symbol","kind":"symbol"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable":{"url":"\/documentation\/optiviewadscore\/pictureinpicturecapable","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","kind":"symbol","abstract":[{"type":"text","text":"Optional capability a "},{"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"role":"symbol","navigatorTitle":[{"text":"PictureInPictureCapable","kind":"identifier"}],"title":"PictureInPictureCapable"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PictureInPictureCapable/onPictureInPictureChange(_:)":{"role":"symbol","required":true,"abstract":[{"type":"text","text":"Install the single observer for presentation-mode changes. The handler"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the window opens and "},{"code":"false","type":"codeVoice"},{"type":"text","text":" when it closes,"},{"type":"text","text":" "},{"type":"text","text":"whoever drove the transition. Installing replaces any previous handler."}],"title":"onPictureInPictureChange(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onPictureInPictureChange