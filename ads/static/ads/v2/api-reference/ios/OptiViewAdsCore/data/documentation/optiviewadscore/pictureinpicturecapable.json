{"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"role":"symbol","roleHeading":"Protocol","title":"PictureInPictureCapable","externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","modules":[{"name":"OptiViewAdsCore"}],"navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}],"symbolKind":"protocol"},"abstract":[{"type":"text","text":"Optional capability a "},{"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"},{"kind":"text","text":" : AnyObject"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The runtime’s default is to drive ","type":"text"},{"code":"AVPictureInPictureController","type":"codeVoice"},{"text":" against the","type":"text"},{"text":" ","type":"text"},{"text":"content ","type":"text"},{"code":"AVPlayerLayer","type":"codeVoice"},{"text":" it discovers in the integrator’s view hierarchy.","type":"text"},{"text":" ","type":"text"},{"text":"That works for players that keep one layer alive across source changes","type":"text"},{"text":" ","type":"text"},{"text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for","type":"text"},{"text":" ","type":"text"},{"text":"players that rebuild their internal pipeline on a source change: THEOplayer","type":"text"},{"text":" ","type":"text"},{"text":"replaces its internal AVPlayer\/layer when ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" is assigned, the","type":"text"},{"text":" ","type":"text"},{"text":"discovered layer dies, and AVKit closes the window at the exact moment the","type":"text"},{"text":" ","type":"text"},{"text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet","type":"text"},{"text":" ","type":"text"},{"text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and","type":"text"},{"text":" ","type":"text"},{"text":"closed at ","type":"text"},{"code":"adbreakbegin","type":"codeVoice"},{"text":", with the ad playing full-screen in the main","type":"text"},{"text":" ","type":"text"},{"text":"window instead of inside it.","type":"text"}]},{"inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"text":" ","type":"text"},{"text":"piece — THEOplayer retains the window across source changes when the host","type":"text"},{"text":" ","type":"text"},{"text":"constructs it with ","type":"text"},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"text":" — but only if the window is driven through THAT facility. This","type":"text"},{"text":" ","type":"text"},{"text":"protocol is how an adapter hands the SDK that steering wheel; the renderer","type":"text"},{"text":" ","type":"text"},{"text":"prefers it over its own controller whenever the content adapter conforms.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"type":"text","text":"thread, for every transition — including viewer-driven ones (the system UI"},{"type":"text","text":" "},{"type":"text","text":"can dismiss the window at any time), which is the whole reason the handler"},{"type":"text","text":" "},{"type":"text","text":"exists: the break format follows what is actually on screen."}],"type":"paragraph"}]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"],"generated":true,"title":"Player contract","anchor":"Player-contract"}],"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/TimedMetadataCue":{"abstract":[{"text":"A single in-stream timed-metadata marker surfaced by a content player — the","type":"text"},{"text":" ","type":"text"},{"text":"Swift mirror of the TS ","type":"text"},{"code":"TimedMetadataCue","type":"codeVoice"},{"type":"text","text":". Carried as the payload of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"ti