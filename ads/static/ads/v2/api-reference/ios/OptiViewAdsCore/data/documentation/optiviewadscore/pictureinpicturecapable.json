ext","text":"picture-in-picture natively."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PictureInPictureCapable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime’s default is to drive "},{"type":"codeVoice","code":"AVPictureInPictureController"},{"type":"text","text":" against the"},{"type":"text","text":" "},{"type":"text","text":"content "},{"type":"codeVoice","code":"AVPlayerLayer"},{"type":"text","text":" it discovers in the integrator’s view hierarchy."},{"type":"text","text":" "},{"type":"text","text":"That works for players that keep one layer alive across source changes"},{"type":"text","text":" "},{"type":"text","text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for"},{"type":"text","text":" "},{"type":"text","text":"players that rebuild their internal pipeline on a source change: THEOplayer"},{"type":"text","text":" "},{"type":"text","text":"replaces its internal AVPlayer\/layer when "},{"type":"codeVoice","code":"source"},{"type":"text","text":" is assigned, the"},{"type":"text","text":" "},{"type":"text","text":"discovered layer dies, and AVKit closes the window at the exact moment the"},{"type":"text","text":" "},{"type":"text","text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet"},{"type":"text","text":" "},{"type":"text","text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and"},{"type":"text","text":" "},{"type":"text","text":"closed at "},{"type":"codeVoice","code":"adbreakbegin"},{"type":"text","text":", with the ad playing full-screen in the main"},{"type":"text","text":" "},{"type":"text","text":"window instead of inside it."}]},{"type":"paragraph","inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"text":" ","type":"text"},{"text":"piece — THEOplayer retains the window across source changes when the host","type":"text"},{"text":" ","type":"text"},{"text":"constructs it with ","type":"text"},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"text":" — but only if the window is driven through THAT facility. This","type":"text"},{"text":" ","type":"text"},{"text":"protocol is how an adapter hands the SDK that steering wheel; the renderer","type":"text"},{"text":" ","type":"text"},{"text":"prefers it over its own controller whenever the content adapter conforms.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three members are called on the main thread (the renderer is"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":"); the change handler must likewise be invoked on the main"},{"type":"text","text":" "},{"type":"text","text":"thread, for every transition — including viewer-driven ones (the system UI"},{"type":"text","text":" "},{"type":"text","text":"can dismiss the window at any time), which is the whole reason the handler"},{"type":"text","text":" "},{"type":"text","text":"exists: the break format follows what is actually on screen."}]}]}],"variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/ContentVideoSizeProvider":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider","role":"symbol","url":"\/documentation\/optiviewadscore\/contentvideosizeprovider","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentVideoSizeProvider"}],"kind":"symbol","type":"topic","ti