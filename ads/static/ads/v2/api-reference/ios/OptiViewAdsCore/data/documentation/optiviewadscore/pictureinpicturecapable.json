{"metadata":{"externalID":"s:15OptiViewAdsCore09PictureInE7CapableP","title":"PictureInPictureCapable","modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"protocol","role":"symbol","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"}],"navigatorTitle":[{"kind":"identifier","text":"PictureInPictureCapable"}]},"topicSections":[{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/isPictureInPicture()","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/onPictureInPictureChange(_:)","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable\/setPictureInPicture(_:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PictureInPictureCapable","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/optiviewadscore\/pictureinpicturecapable"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Optional capability a "},{"type":"reference","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","isActive":true},{"type":"text","text":" implements when its player owns"},{"type":"text","text":" "},{"type":"text","text":"picture-in-picture natively."}],"seeAlsoSections":[{"title":"Player contract","anchor":"Player-contract","generated":true,"identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapterEvent","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/ContentVideoSizeProvider"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PictureInPictureCapable"},{"kind":"text","text":" : AnyObject"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The runtime’s default is to drive ","type":"text"},{"code":"AVPictureInPictureController","type":"codeVoice"},{"text":" against the","type":"text"},{"text":" ","type":"text"},{"text":"content ","type":"text"},{"code":"AVPlayerLayer","type":"codeVoice"},{"text":" it discovers in the integrator’s view hierarchy.","type":"text"},{"text":" ","type":"text"},{"text":"That works for players that keep one layer alive across source changes","type":"text"},{"text":" ","type":"text"},{"text":"(AVPlayer: the SDK swaps the ITEM on the same player), and breaks for","type":"text"},{"text":" ","type":"text"},{"text":"players that rebuild their internal pipeline on a source change: THEOplayer","type":"text"},{"text":" ","type":"text"},{"text":"replaces its internal AVPlayer\/layer when ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is assigned, the","type":"text"},{"text":" ","type":"text"},{"text":"discovered layer dies, and AVKit closes the window at the exact moment the","type":"text"},{"text":" ","type":"text"},{"text":"SDK lends the content player to the ad. Measured on the iOS e2e fleet","type":"text"},{"text":" ","type":"text"},{"text":"(catalog-pip, SDK 0.50.0-beta.500): the window opened before the break and","type":"text"},{"text":" ","type":"text"},{"text":"closed at ","type":"text"},{"code":"adbreakbegin","type":"codeVoice"},{"text":", with the ad playing full-screen in the main","type":"text"},{"text":" ","type":"text"},{"text":"window instead of inside it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Such players expose their own picture-in-picture facility with the missing","type":"text"},{"text":" ","type":"text"},{"text":"piece — THEOplayer retains the window across source changes when the host","type":"text"},{"text":" ","type":"text"},{"text":"constructs it with ","type":"text"},{"code":"PiPConfiguration(retainPresentationModeOnSourceChange: true)","type":"codeVoice"},{"text":" — but only if the window is driven through THAT facility. This","type":"text"},{"text":" ","type":"text"},{"text":"protocol is how an adapter hands the SDK that steering wheel; the renderer","type":"text"},{"text":" ","type":"text"},{"text":"prefers it over its own controller whenever the content adapter conforms.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All three members are called on the main thread (the renderer is","type":"text"},{"text":" ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":"); the change handler must likewise be invoked on the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, for every transition — including viewer-driven ones (the system UI","type":"text"},{"text":" ","type":"text"},{"text":"can dismiss the window at any time), which is the whole reason the handler","type":"text"},{"text":" ","type":"text"},{"text":"exists: the break format follows what is actually on screen.","type":"text"}]}],"kind":"content"}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/TimedMetadataCue":{"url":"\/documentation\/optiviewadscore\/timedmetadatacue","title":"TimedMetadataCue","type":"topic","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/TimedMetadataCue","abstract":[{"text":"A single in-stream timed-metadata marker surfaced by a content player — the","type":"text"},{"text":" ","type":"text"},{"text":"Swift mirror of the TS ","type":"text"},{"code":"TimedMetadataCue","type":"codeVoice"},{"text":". Carried as the payload of a","type":"text"},{"text":" ","type":"text"},{"code":"timedmetadata","type":"codeVoice"},{"text":" event; in SSAI mode the SDK forwards it to the IMA DAI stream","type":"text"},{"text":" ","type":"text"},{"text":"manager for ad tracking.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedMetadataCue"}],"navigatorTitle":[{"kind":"identifier","text":"TimedMetadataCue"}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","title":"PlayerAdapter","role":"symbol","url":"\/documentation\/optiviewadscore\/playeradapter","abstract":[{"text":"The abstraction layer between the SDK and any content player — the Swift","type":"text"},{"text":" ","type":"text"},{"text":"mirror of the Kotlin ","type":"text"},{"code":"PlayerAdapter","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerAdapter"}],"navigatorTitle":[{"kind":"identifier","text":"PlayerAdapter"}],"type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"role":"collection","url":"\/documentation\/optiviewadscore","title":"OptiViewAdsCore","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","kind":"symbol","abstract":[{"text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the","type":"text"},{"type":"text","text":" "},{"code":"PlayerAdapter","type":"codeVoice"},{"text":" contract every content player implements, and the diagnostic taxonomy.","type":"text"}],"type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiV