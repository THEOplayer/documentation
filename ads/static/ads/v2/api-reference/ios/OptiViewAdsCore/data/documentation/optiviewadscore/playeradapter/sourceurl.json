","text":"none."}]},{"type":"paragraph","inlineContent":[{"text":"An adapter that cannot answer returns nil and simply does not get shared-element","type":"text"},{"text":" ","type":"text"},{"text":"insertion; ","type":"text"},{"code":"DA-SHARED-ELEMENT-UNSUPPORTED","type":"codeVoice"},{"text":" explains why.","type":"text"}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Property","externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp","modules":[{"name":"OptiViewAdsCore"}],"title":"sourceUrl","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"role":"symbol","symbolKind":"property","required":true},"sections":[],"variants":[{"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","interfaceLanguage":"swift"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"title":"PlayerAdapter","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapter","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PlayerAdapter"}],"url":"\/documentation\/optiviewadscore\/playeradapter","type":"topic","abstract":[{"text":"The abstraction layer between the SDK and any content player — the Swift","type":"text"},{"text":" ","type":"text"},{"text":"mirror of the Kotlin ","type":"text"},{"code":"PlayerAdapter","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"ti