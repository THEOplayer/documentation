{"metadata":{"modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","role":"symbol","required":true,"title":"sourceUrl","externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"variants":[{"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK lends the content player to an ad on the shared-element path (the ad plays"},{"type":"text","text":" "},{"type":"text","text":"through the content player so it reaches the layer system picture-in-picture is"},{"type":"text","text":" "},{"type":"text","text":"presenting) and has to give it back afterwards. Only the adapter knows what to give"},{"type":"text","text":" "},{"type":"text","text":"back, and it must read that from the PLAYER rather than remember what was passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":": integrators legitimately call "},{"type":"codeVoice","code":"replaceCurrentItem"},{"type":"text","text":" themselves — the demo"},{"type":"text","text":" "},{"type":"text","text":"does — so an adapter tracking only its own calls would report the wrong asset, or"},{"type":"text","text":" "},{"type":"text","text":"none."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An adapter that cannot answer returns nil and simply does not get shared-element"},{"type":"text","text":" "},{"type":"text","text":"insertion; "},{"type":"codeVoice","code":"DA-SHARED-ELEMENT-UNSUPPORTED"},{"type":"text","text":" explains why."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl"},"kind":"symbol","defaultImplementationsSections":[{"anchor":"PlayerAdapter-Implementations","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3"],"title":"PlayerAdapter Implementations"}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl":{"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","type":"topic","required":true,"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl","kind":"symbol","defaultImplementations":1,"title":"sourceUrl"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCo