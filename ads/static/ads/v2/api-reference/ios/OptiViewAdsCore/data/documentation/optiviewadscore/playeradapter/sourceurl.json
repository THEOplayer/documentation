{"defaultImplementationsSections":[{"anchor":"PlayerAdapter-Implementations","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3"],"title":"PlayerAdapter Implementations"}],"abstract":[{"text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface.","type":"text"}],"variants":[{"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The SDK lends the content player to an ad on the shared-element path (the ad plays","type":"text"},{"text":" ","type":"text"},{"text":"through the content player so it reaches the layer system picture-in-picture is","type":"text"},{"text":" ","type":"text"},{"text":"presenting) and has to give it back afterwards. Only the adapter knows what to give","type":"text"},{"text":" ","type":"text"},{"text":"back, and it must read that from the PLAYER rather than remember what was passed to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":": integrators legitimately call "},{"type":"codeVoice","code":"replaceCurrentItem"},{"type":"text","text":" themselves — the demo"},{"type":"text","text":" "},{"type":"text","text":"does — so an adapter tracking only its own calls would report the wrong asset, or"},{"type":"text","text":" "},{"type":"text","text":"none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter that cannot answer returns nil and simply does not get shared-element"},{"type":"text","text":" "},{"type":"text","text":"insertion; "},{"type":"codeVoice","code":"DA-SHARED-ELEMENT-UNSUPPORTED"},{"type":"text","text":" explains why."}]}],"kind":"content"}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"symbolKind":"property","role":"symbol","modules":[{"name":"OptiViewAdsCore"}],"title":"sourceUrl","externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp","required":true,"roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl":{"abstract":[{"text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface.","type":"text"}],"title":"sourceUrl","kind":"symbol","defaultImplementations":1,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl","type":"topic","required":true},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"abstract":[{"text":"The abstraction layer between the SDK and any content player — the Swift","type":"text"},{"text":" ","type":"text"},{"text":"mirror of the Kotlin ","type":"text"},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"PlayerAdapter"}],"url":"\/documentation\/optiviewadscore\/playeradapter","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerAdapter"}],"kind":"symbol","role":"symbol","type":"topic","title":"PlayerAdapter","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"type":"topic","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}],"role":"collection","title":"OptiViewAdsCore","kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","url":"\/documentation\/optiviewadscore"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl-409i3":{"abstract":[{"type":"text","text":"Defaulted, so adding this did not break every existing conformer. Swift has no"},{"type":"text","text":" "},{"type":"text","text":"optional protocol members — the TS core spells the same idea "},{"type":"codeVoice","code":"sourceUrl?:"},{"type":"text","text":" — and"},{"type":"text","text":" "},{"type":"text","text":"this protocol is public, so an integrator’s own adapter would otherwise stop"},{"type":"text","text":" "},{"type":"text","text":"compiling on upgrade. Returning nil means “I cannot say”, which the SDK reads as"},{"type":"text","text":" "},{"type":"text","text":"“no shared-element insertion” rather than as an error."}],"url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl-409i3","role":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"sourceUrl","kind":"symbol"}}}