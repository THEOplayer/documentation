{"defaultImplementationsSections":[{"title":"PlayerAdapter Implementations","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3"],"anchor":"PlayerAdapter-Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK lends the content player to an ad on the shared-element path (the ad plays"},{"type":"text","text":" "},{"type":"text","text":"through the content player so it reaches the layer system picture-in-picture is"},{"type":"text","text":" "},{"type":"text","text":"presenting) and has to give it back afterwards. Only the adapter knows what to give"},{"type":"text","text":" "},{"type":"text","text":"back, and it must read that from the PLAYER rather than remember what was passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":": integrators legitimately call "},{"type":"codeVoice","code":"replaceCurrentItem"},{"type":"text","text":" themselves — the demo"},{"type":"text","text":" "},{"type":"text","text":"does — so an adapter tracking only its own calls would report the wrong asset, or"},{"type":"text","text":" "},{"type":"text","text":"none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter that cannot answer returns nil and simply does not get shared-element"},{"type":"text","text":" "},{"type":"text","text":"insertion; "},{"type":"codeVoice","code":"DA-SHARED-ELEMENT-UNSUPPORTED"},{"type":"text","text":" explains why."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"]}],"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp","required":true,"modules":[{"name":"OptiViewAdsCore"}],"role":"symbol","title":"sourceUrl"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl"},"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"kind":"symbol","sections":[],"abstract":[{"text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface.","type":"text"}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl":{"url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl","abstract":[{"text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface.","type":"text"}],"required":true,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","defaultImplementations":1,"title":"sourceUrl","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"title":"OptiViewAdsCore","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","url":"\/documentation\/optiviewadscore","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"title":"PlayerAdapter","navigatorTitle":[{"text":"PlayerAdapter","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerAdapter","kind":"identifier"}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","abstract":[{"text":"The abstraction layer between the SDK and any content player — the Swift","type":"text"},{"text":" ","type":"text"},{"text":"mirror of the Kotlin ","type":"text"},{"code":"PlayerAdapter","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/optiviewadscore\/playeradapter"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl-409i3":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl-409i3","type":"topic","kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3","abstract":[{"type":"text","text":"Defaulted, so adding this did not break every existing conformer. Swift has no"},{"type":"text","text":" "},{"type":"text","text":"optional protocol members — the TS core spells the same idea "},{"type":"codeVoice","code":"sourceUrl?:"},{"type":"text","text":" — and"},{"type":"text","text":" "},{"type":"text","text":"this protocol is public, so an integrator’s own adapter would otherwise stop"},{"type":"text","text":" "},{"type":"text","text":"compiling on upgrade. Returning nil means “I cannot say”, which the SDK reads as"},{"type":"text","text":" "},{"type":"text","text":"“no shared-element insertion” rather than as an error."}],"title":"sourceUrl"}}}