ext"},{"text":" ","type":"text"},{"text":"through the content player so it reaches the layer system picture-in-picture is","type":"text"},{"text":" ","type":"text"},{"text":"presenting) and has to give it back afterwards. Only the adapter knows what to give","type":"text"},{"text":" ","type":"text"},{"text":"back, and it must read that from the PLAYER rather than remember what was passed to","type":"text"},{"text":" ","type":"text"},{"code":"load(_:)","type":"codeVoice"},{"text":": integrators legitimately call ","type":"text"},{"code":"replaceCurrentItem","type":"codeVoice"},{"text":" themselves — the demo","type":"text"},{"text":" ","type":"text"},{"text":"does — so an adapter tracking only its own calls would report the wrong asset, or","type":"text"},{"text":" ","type":"text"},{"text":"none.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter that cannot answer returns nil and simply does not get shared-element"},{"type":"text","text":" "},{"type":"text","text":"insertion; "},{"code":"DA-SHARED-ELEMENT-UNSUPPORTED","type":"codeVoice"},{"type":"text","text":" explains why."}]}],"kind":"content"}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PlayerAdapter"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerAdapter"}],"type":"topic","title":"PlayerAdapter","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter","url":"\/documentation\/optiviewadscore\/playeradapter","role":"symbol","abstract":[{"type":"text","text":"The abstraction layer between the SDK and any content player — the Swift"},{"type":"text","text":" "},{"type":"text","text":"mirror of the Kotlin "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":"."}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl-409i3":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Defaulted, so adding this did not break every existing conformer. Swift has no"},{"type":"text","text":" "},{"type":"text","text":"optional protocol members — the TS core spells the same idea "},{"type":"codeVoice","code":"sourceUrl?:"},{"type":"text","text":" — and"},{"type":"text","text":" "},{"type":"text","text":"this protocol is public, so an integrator’s own adapter would otherwise stop"},{"type":"text","text":" "},{"type":"text","text":"compiling on upgrade. Returning nil means “I cannot say”, which the SDK reads as"},{"type":"text","text":" "},{"type":"text","text":"“no shared-element insertion” rather than as an error."}],"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3","type":"topic","title":"sourceUrl","kind":"symbol","url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl-409i3"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","url":"\/documentation\/optiviewadscore","title":"OptiViewAdsCore","kind":"symbol","type":"topic","abstract":[{"text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the","type":"text"},{"text":" ","type":"text"},{"code":"PlayerAdapter","type":"codeVoice"},{"text":" contract every content player implements, and the diagnostic taxonomy.","type":"text"}],"role":"collection"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl":{"kind":"symbol","required":true,"url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl","abstract":[{"type":"text","text"