{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"title":"sourceUrl","externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp","role":"symbol","required":true,"symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"OptiViewAdsCore"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The SDK lends the content player to an ad on the shared-element path (the ad plays"},{"type":"text","text":" "},{"type":"text","text":"through the content player so it reaches the layer system picture-in-picture is"},{"type":"text","text":" "},{"type":"text","text":"presenting) and has to give it back afterwards. Only the adapter knows what to give"},{"type":"text","text":" "},{"type":"text","text":"back, and it must read that from the PLAYER rather than remember what was passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":": integrators legitimately call "},{"type":"codeVoice","code":"replaceCurrentItem"},{"type":"text","text":" themselves — the demo"},{"type":"text","text":" "},{"type":"text","text":"does — so an adapter tracking only its own calls would report the wrong asset, or"},{"type":"text","text":" "},{"type":"text","text":"none."}],"type":"paragraph"},{"inlineContent":[{"text":"An adapter that cannot answer returns nil and simply does not get shared-element","type":"text"},{"text":" ","type":"text"},{"text":"insertion; ","type":"text"},{"code":"DA-SHARED-ELEMENT-UNSUPPORTED","type":"codeVoice"},{"text":" explains why.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"defaultImplementationsSections":[{"title":"PlayerAdapter Implementations","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3"],"anchor":"PlayerAdapter-Implementations"}],"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"identifier":{"url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","interfaceLanguage":"swift"},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl":{"defaultImplementations":1,"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"kind":"symbol","url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl","role":"symbol","required":true,"type":"topic","title":"sourceUrl","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"url":"\/documentat