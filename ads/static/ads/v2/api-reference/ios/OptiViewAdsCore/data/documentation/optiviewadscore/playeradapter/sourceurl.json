{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"]}],"defaultImplementationsSections":[{"anchor":"PlayerAdapter-Implementations","title":"PlayerAdapter Implementations","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3"]}],"metadata":{"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"required":true,"modules":[{"name":"OptiViewAdsCore"}],"title":"sourceUrl","externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp"},"sections":[],"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK lends the content player to an ad on the shared-element path (the ad plays"},{"type":"text","text":" "},{"type":"text","text":"through the content player so it reaches the layer system picture-in-picture is"},{"type":"text","text":" "},{"type":"text","text":"presenting) and has to give it back afterwards. Only the adapter knows what to give"},{"type":"text","text":" "},{"type":"text","text":"back, and it must read that from the PLAYER rather than remember what was passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":": integrators legitimately call "},{"type":"codeVoice","code":"replaceCurrentItem"},{"type":"text","text":" themselves — the demo"},{"type":"text","text":" "},{"type":"text","text":"does — so an adapter tracking only its own calls would report the wrong asset, or"},{"type":"text","text":" "},{"type":"text","text":"none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter that cannot answer returns nil and simply does not get shared-element"},{"type":"text","text":" "},{"type":"text","text":"insertion; "},{"type":"codeVoice","code":"DA-SHARED-ELEMENT-UNSUPPORTED"},{"type":"text","text":" explains why."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl"},"kind":"symbol","references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl":{"role":"symbol","url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl","abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"required":true,"defaultImplementations":1,"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl","title":"sourceUrl","type":"topic"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl-409i3":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3","role":"symbol","abstract":[{"type":"text","text":"Defaulted, so adding this did not break every existing conformer. Swift has no"},{"type":"text","text":" "},{"type":"text","text":"optional protocol members — the TS core spells the same idea "},{"code":"sourceUrl?:","type":"codeVoice"},{"type":"text","text":" — and"},{"type":"text","text":" "},{"type":"text","text":"this protocol is public, so an integrator’s own adapter would otherwise stop"},{"type":"text","text":" "},{"type":"text","text":"compiling on upgrade. Returning nil means “I cannot say”, which the SDK reads as"},{"type":"text","text":" "},{"type":"text","text":"“no shared-element insertion” rather than as an error."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceUrl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl-409i3","title":"sourceUrl","kind":"symbol"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"role":"collection","url":"\/documentation\/optiviewadscore","abstract":[{"type":"text","text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" contract every content player implements, and the diagnostic taxonomy."}],"kind":"symbol","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","type":"topic","title":"OptiViewAdsCore"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"kind":"symbol","abstract":[{"type":"text","text":"The abstraction layer between the SDK and any content player — the Swift"},{"type":