"type":"text"},{"text":" ","type":"text"},{"text":"back, and it must read that from the PLAYER rather than remember what was passed to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"load(_:)"},{"text":": integrators legitimately call ","type":"text"},{"type":"codeVoice","code":"replaceCurrentItem"},{"text":" themselves — the demo","type":"text"},{"text":" ","type":"text"},{"text":"does — so an adapter tracking only its own calls would report the wrong asset, or","type":"text"},{"text":" ","type":"text"},{"text":"none.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An adapter that cannot answer returns nil and simply does not get shared-element","type":"text"},{"text":" ","type":"text"},{"text":"insertion; ","type":"text"},{"type":"codeVoice","code":"DA-SHARED-ELEMENT-UNSUPPORTED"},{"text":" explains why.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl"},"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore":{"identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","abstract":[{"text":"The portable, player-agnostic types of the OptiView Ads SDK: the break-manifest model, the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PlayerAdapter"},{"text":" contract every content player implements, and the diagnostic taxonomy.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/optiviewadscore","kind":"symbol","title":"OptiViewAdsCore"},"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter":{"role":"symbol","title":"PlayerAdapter","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Pla