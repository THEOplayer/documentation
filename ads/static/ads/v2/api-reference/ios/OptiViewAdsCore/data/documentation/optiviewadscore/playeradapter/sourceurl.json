{"hierarchy":{"paths":[["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore","doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK lends the content player to an ad on the shared-element path (the ad plays"},{"type":"text","text":" "},{"type":"text","text":"through the content player so it reaches the layer system picture-in-picture is"},{"type":"text","text":" "},{"type":"text","text":"presenting) and has to give it back afterwards. Only the adapter knows what to give"},{"type":"text","text":" "},{"type":"text","text":"back, and it must read that from the PLAYER rather than remember what was passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":": integrators legitimately call "},{"type":"codeVoice","code":"replaceCurrentItem"},{"type":"text","text":" themselves — the demo"},{"type":"text","text":" "},{"type":"text","text":"does — so an adapter tracking only its own calls would report the wrong asset, or"},{"type":"text","text":" "},{"type":"text","text":"none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter that cannot answer returns nil and simply does not get shared-element"},{"type":"text","text":" "},{"type":"text","text":"insertion; "},{"type":"codeVoice","code":"DA-SHARED-ELEMENT-UNSUPPORTED"},{"type":"text","text":" explains why."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadscore\/playeradapter\/sourceurl"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl"},"abstract":[{"type":"text","text":"Optional: the URL this adapter is currently playing — the ASSET, not a surface."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"defaultImplementationsSections":[{"title":"PlayerAdapter Implementations","anchor":"PlayerAdapter-Implementations","identifiers":["doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3"]}],"metadata":{"required":true,"externalID":"s:15OptiViewAdsCore13PlayerAdapterP9sourceUrlSSSgvp","modules":[{"name":"OptiViewAdsCore"}],"symbolKind":"property","role":"symbol","roleHeading":"Instance Property","title":"sourceUrl","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"references":{"doc://optiviewadscore.OptiViewAdsCore/documentation/OptiViewAdsCore/PlayerAdapter/sourceUrl-409i3":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceUrl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","url":"\/documentation\/optiviewadscore\/playeradapter\/sourceurl-409i3","identifier":"doc:\/\/optiviewadscore.OptiViewAdsCore\/documentation\/OptiViewAdsCore\/PlayerAdapter\/sourceUrl-409i3","abstract":[{"type":"text","text":"Defaulted, so adding this did not break every existing conformer. Swift has no"},{"type":"text","text":" "},{"type":"text","text":"optional protocol members — the TS core spells the same idea "},