{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"]]},"metadata":{"modules":[{"name":"OptiViewAdsRuntime"}],"roleHeading":"Instance Method","role":"symbol","externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC15playImmediatelyyyF","title":"playImmediately()","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playImmediately","kind":"identifier"},{"text":"()","kind":"text"}]},"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/playImmediately()","interfaceLanguage":"swift"},"abstract":[{"text":"Start playback WITHOUT AVPlayer’s stall-minimization hold.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"playImmediately"},{"kind":"text","text":"()"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"code":"play()","type":"codeVoice"},{"type":"text","text":" respects "},{"code":"automaticallyWaitsToMinimizeStalling","type":"codeVoice"},{"type":"text","text":": the player keeps"},{"type":"text","text":" "},{"type":"text","text":"rate at 0 while it re-evaluates whether playback can keep up, which costs"},{"type":"text","text":" "},{"type":"text","text":"~half a second of frozen frame even on an item whose buffer is already"},{"type":"text","text":" "},{"type":"text","text":"full. That re-evaluation buys nothing on a pre-warmed handoff — the item"},{"type":"text","text":" "},{"type":"text","text":"was buffered on the warm-up player precisely so it can start instantly —"},{"type":"text","text":" "},{"type":"text","text":"so the renderer uses this for warmed items only; cold loads keep "},{"code":"play()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and its stall protection."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Protocol surface since the live resume needs it too: that path corrects content’s"},{"type":"text","text":" "},{"type":"text","text":"position repeatedly behind the ad, and the hold re-engages on every correction, so"},{"type":"text","text":" "},{"type":"text","text":"what costs half a second once costs a second per correction there."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()"]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter/playImmediately()":{"title":"playImmediately()","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Start playback WITHOUT AVPlayer’s stall-minimization hold."}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/playImmediately()","kind":"symbol","url":"\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playImmediately","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"title":"OptiViewAdsRuntime","type":"topic","url":"\/documentation\/optiviewadsruntime","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","abstract":[{"type":"text","text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the"},{"type":"text","text":" "},{"type":"text","text":"overlay ad renderer, and the Google IMA integrations."}],"kind":"symbol","role":"c