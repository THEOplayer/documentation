ery correction, so"},{"type":"text","text":" "},{"type":"text","text":"what costs half a second once costs a second per correction there."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"method","title":"playImmediately()","role":"symbol","modules":[{"name":"OptiViewAdsRuntime"}],"roleHeading":"Instance Method","externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC15playImmediatelyyyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"playImmediately"},{"text":"()","kind":"text"}]},"abstract":[{"type":"text","text":"Start playback WITHOUT AVPlayer’s stall-minimization hold."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()"]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"role":"collection","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","title":"OptiViewAdsRuntime","type":"topic","abstract":[{"type":"text","text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the"},{"type":"text","text":" "},{"type":"text","text":"overlay ad renderer, and the Google IMA integrations."}],"kind":"symbol","url":"\/documentation\/optiviewadsruntime"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter":{"title":"AVPlayerAdapter","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVPlayerAdapter"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AVPlayerAdapter"}],"url":"\/documentation\/optiviewadsruntime\/avplayeradapter","abstract":[{"type":"text","text":"AVFoundation implementation of the portable "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" (P5b)."}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntim