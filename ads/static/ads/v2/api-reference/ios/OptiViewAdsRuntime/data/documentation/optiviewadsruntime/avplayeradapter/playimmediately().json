xt":" ","type":"text"},{"text":"so the renderer uses this for warmed items only; cold loads keep ","type":"text"},{"code":"play()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and its stall protection.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Protocol surface since the live resume needs it too: that path corrects content’s","type":"text"},{"text":" ","type":"text"},{"text":"position repeatedly behind the ad, and the hold re-engages on every correction, so","type":"text"},{"text":" ","type":"text"},{"text":"what costs half a second once costs a second per correction there.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()"]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"role":"collection","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","kind":"symbol","type":"topic","abstract":[{"text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the","type":"text"},{"text":" ","type":"text"},{"text":"overlay ad renderer, and the Google IMA integrations.","type":"text"}],"url":"\/documentation\/optiviewadsruntime","title":"OptiViewAdsRuntime"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter/playImmediately()":{"url":"\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()","title":"playImmediately()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playImmediately","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/playImmediately()","abstract":[{"type":"text","text":"Start playback WITHOUT AVPlayer’s stall-minimization hold."}],"role":"symbol","kind":"symbol","typ