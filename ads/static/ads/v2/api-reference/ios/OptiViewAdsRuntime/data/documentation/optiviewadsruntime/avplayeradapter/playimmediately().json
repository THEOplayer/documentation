{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"playImmediately"},{"kind":"text","text":"()"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"play()"},{"type":"text","text":" respects "},{"type":"codeVoice","code":"automaticallyWaitsToMinimizeStalling"},{"type":"text","text":": the player keeps"},{"type":"text","text":" "},{"type":"text","text":"rate at 0 while it re-evaluates whether playback can keep up, which costs"},{"type":"text","text":" "},{"type":"text","text":"~half a second of frozen frame even on an item whose buffer is already"},{"type":"text","text":" "},{"type":"text","text":"full. That re-evaluation buys nothing on a pre-warmed handoff — the item"},{"type":"text","text":" "},{"type":"text","text":"was buffered on the warm-up player precisely so it can start instantly —"},{"type":"text","text":" "},{"type":"text","text":"so the renderer uses this for warmed items only; cold loads keep "},{"type":"codeVoice","code":"play()"},{"type":"text","text":" "},{"type":"text","text":"and its stall protection."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Protocol surface since the live resume needs it too: that path corrects content’s"},{"type":"text","text":" "},{"type":"text","text":"position repeatedly behind the ad, and the hold re-engages on every correction, so"},{"type":"text","text":" "},{"type":"text","text":"what costs half a second once costs a second per correction there."}],"type":"paragraph"}]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playImmediately","kind":"identifier"},{"text":"()","kind":"text"}],"title":"playImmediately()","modules":[{"name":"OptiViewAdsRuntime"}],"role":"symbol","externalID":"s:18OptiViewAdsRuntime1