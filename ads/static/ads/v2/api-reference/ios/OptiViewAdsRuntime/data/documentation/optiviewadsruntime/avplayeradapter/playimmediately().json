{"abstract":[{"text":"Start playback WITHOUT AVPlayer’s stall-minimization hold.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/playImmediately()"},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"OptiViewAdsRuntime"}],"title":"playImmediately()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"playImmediately"},{"kind":"text","text":"()"}],"role":"symbol","externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC15playImmediatelyyyF"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"playImmediately"},{"kind":"text","text":"()"}]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"codeVoice","code":"play()"},{"type":"text","text":" respects "},{"type":"codeVoice","code":"automaticallyWaitsToMinimizeStalling"},{"type":"text","text":": the player keeps"},{"type":"text","text":" "},{"type":"text","text":"rate at 0 while it re-evaluates whether playback can keep up, which costs"},{"type":"text","text":" "},{"type":"text","text":"~half a second of frozen frame even on an item whose buffer is already"},{"type":"text","text":" "},{"type":"text","text":"full. That re-evaluation buys nothing on a pre-warmed handoff — the item"},{"type":"text","text":" "},{"type":"text","text":"was buffered on the warm-up player precisely so it can start instantly —"},{"type":"text","text":" "},{"type":"text","text":"so the renderer uses this for warmed items only; cold loads keep "},{"type":"codeVoice","code":"play()"},{"type":"text","text":" "},{"type":"text","text":"and its stall protection."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"P