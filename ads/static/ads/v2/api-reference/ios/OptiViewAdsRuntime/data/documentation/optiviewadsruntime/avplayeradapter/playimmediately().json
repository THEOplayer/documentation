{"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"]]},"metadata":{"modules":[{"name":"OptiViewAdsRuntime"}],"symbolKind":"method","title":"playImmediately()","role":"symbol","externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC15playImmediatelyyyF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playImmediately","kind":"identifier"},{"text":"()","kind":"text"}]},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/playImmediately()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Start playback WITHOUT AVPlayer’s stall-minimization hold.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playImmediately","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"play()"},{"type":"text","text":" respects "},{"type":"codeVoice","code":"automaticallyWaitsToMinimizeStalling"},{"type":"text","text":": the player keeps"},{"type":"text","text":" "},{"type":"text","text":"rate at 0 while it re-evaluates whether playback can keep up, which costs"},{"type":"text","text":" "},{"type":"text","text":"~half a second of frozen frame even on an item whose buffer is already"},{"type":"text","text":" "},{"type":"text","text":"full. That re-evaluation buys nothing on a pre-warmed handoff — the item"},{"type":"text","text":" "},{"type":"text","text":"was buffered on the warm-up player precisely so it can start instantly —"},{"type":"text","text":" "},{"type":"text","text":"so the renderer uses this for warmed items only; cold loads keep "},{"type":"codeVoice","code":"play()"},{"type":"text","text":" "},{"type":"text","text":"and its stall protection."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol surface since the live resume needs it too: that path corrects content’s"},{"type":"text","text":" "},{"type":"text","text":"position repeatedly behind the ad, and the hold re-engages on every correction, so"},{"type":"text","text":" "},{"type":"text","text":"what costs half a second once costs a second per correction there."}]}]}],"variants":[{"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter/playImmediately()":{"abstract":[{"type":"text","text":"Start playback WITHOUT AVPlayer’s stall-minimization hold."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"playImmediately"},{"kind":"text","text":"()"}],"role":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/playImmediately()","title":"playImmediately()","type":"topic","url":"\/documentation\/optiviewadsruntime\/avplayeradapter\/playimmediately()","kind":"symbol"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter":{"type":"topic","role":"symbol","title":"AVPlayerAdapter","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVPlayerAdapter","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/optiviewadsruntime\/avplayeradapter","navigatorTitle":[{"text":"AVPlayerAdapter","kind":"identifier"}],"abstract":[{"type":"