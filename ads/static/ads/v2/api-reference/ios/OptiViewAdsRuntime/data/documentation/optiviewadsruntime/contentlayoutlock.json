{"metadata":{"title":"ContentLayoutLock","modules":[{"name":"OptiViewAdsRuntime"}],"navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"roleHeading":"Class","externalID":"s:18OptiViewAdsRuntime17ContentLayoutLockC","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"role":"symbol","symbolKind":"class"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Some RN host players (react-native-theoplayer) re-stamp their internal","type":"text"},{"text":" ","type":"text"},{"text":"player frame from the host view’s ","type":"text"},{"inlineContent":[{"type":"text","text":"frame"}],"type":"emphasis"},{"text":" on every layout pass","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"THEOplayerRCTView.layoutSubviews","type":"codeVoice"},{"text":" does ","type":"text"},{"code":"player.frame = self.frame","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"While the split transform is installed, the host view’s frame is the","type":"text"},{"text":" ","type":"text"},{"text":"transformed bounding box, so each pass applies the layout fraction to the","type":"text"},{"text":" ","type":"text"},{"text":"picture a SECOND time — the content renders at fraction² of its box — and","type":"text"},{"text":" ","type":"text"},{"text":"drifts the picture out of the frozen content mask, exposing black regions","type":"text"},{"text":" ","type":"text"},{"text":"inside the box. react-native-video is immune: its layout stamps sublayers","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":", which a transform never changes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The lock captures the healthy pre-transform frame at acquisition and","type":"text"},{"text":" ","type":"text"},{"text":"re-asserts it (through the host’s own frame API, via ","type":"text"},{"code":"restamp","type":"codeVoice"},{"text":") whenever","type":"text"},{"text":" ","type":"text"},{"text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView","type":"text"},{"text":" ","type":"text"},{"text":"geometry setters are not KVO-compliant, CALayer’s ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"position","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"— the same technique as the overlay host view’s host-layer observers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct on the main thread (it reads and may re-stamp view geometry);"},{"type":"text","text":" "},{"code":"release","type":"codeVoice"},{"type":"text","text":" only invalidates the observations and is safe from any thread."}]}]}],"variants":[{"paths":["\/documentation\/optiviewadsruntime\/contentlayoutlock"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"]]},"topicSections":[{"identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true}],"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","interfaceLanguage":"swift"},"abstract":[{"text":"Pins a host player’s internal video surface to a fixed frame while the","type":"text"},{"text":" ","type":"text"},{"text":"split-layout reflow has a transform installed on the host view (PLAYG-513).","type":"text"}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"abstract":[{"text":"Stops holding the frame. The host’s next layout pass re-stamps its own","type":"text"},{"type":"text","text":" "},{"type":"text","text":"geometry from the (by then restored) host view frame."}],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","role":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}],"title":"release()"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/init(internalView:desiredFrame:restamp:)":{"kind":"symbol","role":"symbol","title":"init(internalView:desiredFrame:restamp:)","abstract":[],"fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"internalView"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)UIView","kind":"typeIdentifier","text":"UIView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"desiredFrame"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@S@CGRect","kind":"typeIdentifier","text":"CGRect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"restamp"},{"kind":"text","text":": ("},{"preciseIdentifier":"c:@S@CGRect","kind":"typeIdentifier","text":"CGRect"},{"kind":"text","text":") -> "},{"preciseIden