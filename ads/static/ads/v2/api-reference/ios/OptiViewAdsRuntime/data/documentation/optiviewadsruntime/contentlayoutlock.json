{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some RN host players (react-native-theoplayer) re-stamp their internal"},{"type":"text","text":" "},{"type":"text","text":"player frame from the host view’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"frame"}]},{"type":"text","text":" on every layout pass"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"THEOplayerRCTView.layoutSubviews"},{"type":"text","text":" does "},{"type":"codeVoice","code":"player.frame = self.frame"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the split transform is installed, the host view’s frame is the"},{"type":"text","text":" "},{"type":"text","text":"transformed bounding box, so each pass applies the layout fraction to the"},{"type":"text","text":" "},{"type":"text","text":"picture a SECOND time — the content renders at fraction² of its box — and"},{"type":"text","text":" "},{"type":"text","text":"drifts the picture out of the frozen content mask, exposing black regions"},{"type":"text","text":" "},{"type":"text","text":"inside the box. react-native-video is immune: its layout stamps sublayers"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":", which a transform never changes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The lock captures the healthy pre-transform frame at acquisition and"},{"type":"text","text":" "},{"type":"text","text":"re-asserts it (through the host’s own frame API, via "},{"type":"codeVoice","code":"restamp"},{"type":"text","text":") whenever"},{"type":"text","text":" "},{"type":"text","text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView"},{"type":"text","text":" "},{"type":"text","text":"geometry setters are not KVO-compliant, CALayer’s "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"position"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"— the same technique as the overlay host view’s host-layer observers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct on the main thread (it reads and may re-stamp view geometry);"},{"type":"text","text":" "},{"type":"codeVoice","code":"release"},{"type":"text","text":" only invalidates the observations and is safe from any thread."}]}],"kind":"content"}],"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()"],"anchor":"Instance-Methods","generated":true}],"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"]]},"metadata":{"symbolKind":"class","role":"symbol","title":"ContentLayoutLock","modules":[{"name":"OptiViewAdsRuntime"}],"externalID":"s:18OptiViewAdsRuntime17ContentLayoutLockC","navigatorTitle":[{"kind":"identifier","text":"ContentLayoutLock"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}],"roleHeading":"Class"},"abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/contentlayoutlock"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"title":"OptiViewAdsRuntime","type":"topic","abstract":[{"text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the","type":"text"},{"text":" ","type":"text"},{"text":"overlay ad renderer, and the Google IMA integrations.","type":"text"}],"kind":"symbol","role":"collection","url":"\/documentation\/optiviewadsruntime","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"kind":"symbol","type":"topic","title":"release()","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","role":"symbol","abstract":[{"type":"text","text":"Stops holding the frame. The host’s next layout pass re-stamps its own"},{"type":"text","text":" "},{"type":"text","text":"geometry from the (by then restored) host view frame."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"release","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/init(internalView:desiredFrame:restamp:)":{"kind":"symbol","type":"topic","title":"init(internalView:desiredFrame:restamp:)","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLa