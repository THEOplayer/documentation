pter, the","type":"text"},{"text":" ","type":"text"},{"text":"overlay ad renderer, and the Google IMA integrations.","type":"text"}],"type":"topic"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}],"role":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","title":"release()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Stops holding the frame. The host’s next layout pass re-stamps its own"},{"type":"text","text":" "},{"type":"text","text":"geometry from the (by then restored) host view frame."}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock":{"abstract":[{"text":"Pins a host player’s internal video surface to a fixed frame while the","type":"text"},{"text":" ","type":"text"},{"text":"split-layout reflow has a transform installed on the host view (PLAYG-513).","type":"text"}],"type":"topic","title":"ContentLayoutLock","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}],"navigatorTitle":[{"kind":"identifier","text":"ContentLayoutLock"}],"kind":"symbol","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock"}}}