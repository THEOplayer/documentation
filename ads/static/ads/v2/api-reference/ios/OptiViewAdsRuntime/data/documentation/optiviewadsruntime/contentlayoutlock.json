and may re-stamp view geometry);","type":"text"},{"text":" ","type":"text"},{"code":"release","type":"codeVoice"},{"text":" only invalidates the observations and is safe from any thread.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/optiviewadsruntime\/contentlayoutlock"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","kind":"symbol","title":"release()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"release","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","type":"topic","abstract":[{"text":"Stops holding the frame. The host’s next layout pass re-stamps its own","type":"text"},{"text":" ","type":"text"},{"text":"geometry from the (by then restored) host view frame.","type":"text"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock":{"title":"ContentLayoutLock","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","type":"topic","abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"url":"\/documentation\/optiv