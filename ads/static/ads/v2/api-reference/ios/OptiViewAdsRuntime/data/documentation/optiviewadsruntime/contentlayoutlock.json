pass"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"THEOplayerRCTView.layoutSubviews"},{"type":"text","text":" does "},{"type":"codeVoice","code":"player.frame = self.frame"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the split transform is installed, the host view’s frame is the"},{"type":"text","text":" "},{"type":"text","text":"transformed bounding box, so each pass applies the layout fraction to the"},{"type":"text","text":" "},{"type":"text","text":"picture a SECOND time — the content renders at fraction² of its box — and"},{"type":"text","text":" "},{"type":"text","text":"drifts the picture out of the frozen content mask, exposing black regions"},{"type":"text","text":" "},{"type":"text","text":"inside the box. react-native-video is immune: its layout stamps sublayers"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":", which a transform never changes."}],"type":"paragraph"},{"inlineContent":[{"text":"The lock captures the healthy pre-transform frame at acquisition and","type":"text"},{"text":" ","type":"text"},{"text":"re-asserts it (through the host’s own frame API, via ","type":"text"},{"code":"restamp","type":"codeVoice"},{"text":") whenever","type":"text"},{"text":" ","type":"text"},{"text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView","type":"text"},{"text":" ","type":"text"},{"text":"geometry setters are not KVO-compliant, CALayer’s ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"position","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"— the same technique as the overlay host view’s host-layer observers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Construct on the main thread (it reads and may re-stamp view geometry);","type":"text"},{"text":" ","type":"text"},{"code":"release","type":"codeVoice"},{"text":" only invalidates the observations and is safe from any thread.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Pins a host player’s internal video surface to a fixed frame while the","type":"text"},{"text":" ","type":"text"},{"text":"split-layout reflow has a transform installed on the host view (PLAYG-513).","type":"text"}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"kind":"symbol","type":"topic","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","abstract":[{"text":"Stops holding the frame. The host’s next layout pass re-stamps its own","type":"text"},{"text":" ","type":"text"},{"text":"geometry from the (by then restored) host view frame.","type":"text"}],"role":"symbol","title":"release()","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"abstract":[{"text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the","type":"text"},{"text":" ","type":"text"},{"text":"overlay ad renderer, and the Google IMA integrations.","type":"text"}],"role":"collection","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","url":"\/documentation\/optiviewadsruntime","kind":"symbol","type":"topic","title":"OptiViewAdsRuntime"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/init(internalView:desiredFrame:restamp:)":{"kind":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)","title":"init(internalView:desiredFram