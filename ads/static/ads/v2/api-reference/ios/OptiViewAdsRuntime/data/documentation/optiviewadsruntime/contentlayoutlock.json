e AVFoundation content-player adapter, the"},{"type":"text","text":" "},{"type":"text","text":"overlay ad renderer, and the Google IMA integrations."}],"role":"collection"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","title":"release()","abstract":[{"type":"text","text":"Stops holding the frame. The host’s next layout pass re-stamps its own"},{"type":"text","text":" "},{"type":"text","text":"geometry from the (by then restored) host view frame."}],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","kind":"symbol","role":"symbol","type":"topic"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","title":"ContentLayoutLock","navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"abstract":[{"text":"Pins a host player’s internal video surface to a fixed frame while the","type":"text"},{"text":" ","type":"text"},{"text":"split-layout reflow has a transform installed on the host view (PLAYG-513).","type":"text"}],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock","kind":"symbol","role":"symbol","type":"topic"}}}