{"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"]]},"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"metadata":{"title":"ContentLayoutLock","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"symbolKind":"class","modules":[{"name":"OptiViewAdsRuntime"}],"externalID":"s:18OptiViewAdsRuntime17ContentLayoutLockC","roleHeading":"Class"},"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()"],"anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Some RN host players (react-native-theoplayer) re-stamp their internal"},{"type":"text","text":" "},{"type":"text","text":"player frame from the host view’s "},{"inlineContent":[{"text":"frame","type":"text"}],"type":"emphasis"},{"text":" on every layout pass","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"THEOplayerRCTView.layoutSubviews"},{"text":" does ","type":"text"},{"type":"codeVoice","code":"player.frame = self.frame"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"While the split transform is installed, the host view’s frame is the","type":"text"},{"text":" ","type":"text"},{"text":"transformed bounding box, so each pass applies the layout fraction to the","type":"text"},{"text":" ","type":"text"},{"text":"picture a SECOND time — the content renders at fraction² of its box — and","type":"text"},{"text":" ","type":"text"},{"text":"drifts the picture out of the frozen content mask, exposing black regions","type":"text"},{"text":" ","type":"text"},{"text":"inside the box. react-native-video is immune: its layout stamps sublayers","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"bounds"},{"text":", which a transform never changes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The lock captures the healthy pre-transform frame at acquisition and","type":"text"},{"text":" ","type":"text"},{"text":"re-asserts it (through the host’s own frame API, via ","type":"text"},{"code":"restamp","type":"codeVoice"},{"text":") whenever","type":"text"},{"text":" ","type":"text"},{"text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView","type":"text"},{"text":" ","type":"text"},{"text":"geometry setters are not KVO-compliant, CALayer’s ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"position","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"— the same technique as the overlay host view’s host-layer observers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Construct on the main thread (it reads and may re-stamp view geometry);"},{"type":"text","text":" "},{"type":"codeVoice","code":"release"},{"type":"text","text":" only invalidates the observations and is safe from any thread."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/contentlayoutlock"]}],"sections":[],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock":{"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","title":"ContentLayoutLock","abstract":[{"text":"Pins a host player’s internal video surface to a fixed frame while the","type":"text"},{"text":" ","type":"text"},{"text":"split-layout reflow has a transform installed on the host view (PLAYG-513).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ContentLayoutLock"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/init(internalView:desiredFrame:restamp:)":{"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"internalView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIView","text":"UIView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"desiredFrame"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@S@CGRect","text":"CGRect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"restamp"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"c:@S@CGRect","text":"CGRect"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")"}],"abstract":[],"url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/init(internalview_desiredframe_restamp_)","role":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)","kind":"symbol","title":"init(internalView:desiredFrame:restamp:)"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"role":"collection","abstract":[{"type":"text","text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the"},{"type":"text","text":" "},{"type":"text","text":"overlay ad renderer, and the Google IMA integrations."}],"url":"\/documentation\/optiviewadsruntime","type":"topic","title":"OptiViewAdsRuntime","kind":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"role":"symbol","title":"release()","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","abstract":[{"type":"text","text":"Stops holding the frame. The host’s next layout pass re-stamps its own"},{"type":"text","text":" "},{"type":"text","text":"geometry from the (by then restored) host view frame."}],"kind":"symbol"}}}