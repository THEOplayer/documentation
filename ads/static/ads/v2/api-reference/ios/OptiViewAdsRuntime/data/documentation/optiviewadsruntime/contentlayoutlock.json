{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock"},"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"metadata":{"externalID":"s:18OptiViewAdsRuntime17ContentLayoutLockC","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}],"roleHeading":"Class","title":"ContentLayoutLock","modules":[{"name":"OptiViewAdsRuntime"}],"role":"symbol","navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}]},"abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some RN host players (react-native-theoplayer) re-stamp their internal"},{"type":"text","text":" "},{"type":"text","text":"player frame from the host view’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"frame"}]},{"type":"text","text":" on every layout pass"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"THEOplayerRCTView.layoutSubviews"},{"type":"text","text":" does "},{"type":"codeVoice","code":"player.frame = self.frame"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"While the split transform is installed, the host view’s frame is the"},{"type":"text","text":" "},{"type":"text","text":"transformed bounding box, so each pass applies the layout fraction to the"},{"type":"text","text":" "},{"type":"text","text":"picture a SECOND time — the content renders at fraction² of its box — and"},{"type":"text","text":" "},{"type":"text","text":"drifts the picture out of the frozen content mask, exposing black regions"},{"type":"text","text":" "},{"type":"text","text":"inside the box. react-native-video is immune: its layout stamps sublayers"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":", which a transform never changes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The lock captures the healthy pre-transform frame at acquisition and"},{"type":"text","text":" "},{"type":"text","text":"re-asserts it (through the host’s own frame API, via "},{"type":"codeVoice","code":"restamp"},{"type":"text","text":") whenever"},{"type":"text","text":" "},{"type":"text","text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView"},{"type":"text","text":" "},{"type":"text","text":"geometry setters are not KVO-compliant, CALayer’s "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"position"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"— the same technique as the overlay host view’s host-layer observers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct on the main thread (it reads and may re-stamp view geometry);"},{"type":"text","text":" "},{"type":"codeVoice","code":"release"},{"type":"text","text":" only invalidates the observations and is safe from any thread."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/contentlayoutlock"]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}],"role":"symbol","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","title":"release()","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","abstract":[{"text":"Stops holding the frame. The host’s next layout pass re-stamps its own","type":"text"},{"text":" ","type":"text"},{"text":"geometry from the (by then restored) host view frame.","type":"text"}],"type":"topic"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","title":"ContentLayoutLock","type":"topic","abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"kind":"symbol","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"role