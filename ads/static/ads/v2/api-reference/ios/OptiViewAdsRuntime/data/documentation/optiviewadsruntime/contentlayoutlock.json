action to the","type":"text"},{"text":" ","type":"text"},{"text":"picture a SECOND time — the content renders at fraction² of its box — and","type":"text"},{"text":" ","type":"text"},{"text":"drifts the picture out of the frozen content mask, exposing black regions","type":"text"},{"text":" ","type":"text"},{"text":"inside the box. react-native-video is immune: its layout stamps sublayers","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":", which a transform never changes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The lock captures the healthy pre-transform frame at acquisition and","type":"text"},{"text":" ","type":"text"},{"text":"re-asserts it (through the host’s own frame API, via ","type":"text"},{"type":"codeVoice","code":"restamp"},{"text":") whenever","type":"text"},{"text":" ","type":"text"},{"text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView","type":"text"},{"text":" ","type":"text"},{"text":"geometry setters are not KVO-compliant, CALayer’s ","type":"text"},{"type":"codeVoice","code":"bounds"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"position"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"— the same technique as the overlay host view’s host-layer observers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Construct on the main thread (it reads and may re-stamp view geometry);"},{"type":"text","text":" "},{"type":"codeVoice","code":"release"},{"type":"text","text":" only invalidates the observations and is safe from any thread."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"metadata":{"title":"ContentLayoutLock","roleHeading":"Class","symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"modules":[{"name":"OptiViewAdsRuntime"}],"externalID":"s:18OptiViewAdsRuntime17ContentLayoutLockC","role":"symbol"},"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/release()":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"()"}],"role":"symbol","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/release()","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()","title":"release()","abstract":[{"text":"Stops holding the frame. The host’s next layout pass re-stamps its own","type":"text"},{"text":" ","type":"text"},{"text":"geometry from the (by then restored) host view frame.","type":"text"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/init(internalView:desiredFrame:restamp:)":{"role":"symbol","type":"topic","title":"init(internalView:desiredFrame:restamp:)","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock\/init(internalview:desiredframe:restamp:)","abstract":[],"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"internalView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIView","text":"UIView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"desiredFrame"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@S@CGRect","text":"CGRect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"restamp"},{"kind":"text","text":": ("},{"kind":"typeIdentifier"