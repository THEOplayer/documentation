{"metadata":{"title":"ContentLayoutLock","modules":[{"name":"OptiViewAdsRuntime"}],"navigatorTitle":[{"text":"ContentLayoutLock","kind":"identifier"}],"roleHeading":"Class","role":"symbol","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}],"externalID":"s:18OptiViewAdsRuntime17ContentLayoutLockC"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/contentlayoutlock"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock"},"abstract":[{"text":"Pins a host player’s internal video surface to a fixed frame while the","type":"text"},{"text":" ","type":"text"},{"text":"split-layout reflow has a transform installed on the host view (PLAYG-513).","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/init(internalView:desiredFrame:restamp:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock\/release()"],"title":"Instance Methods","generated":true}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentLayoutLock","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Some RN host players (react-native-theoplayer) re-stamp their internal","type":"text"},{"text":" ","type":"text"},{"text":"player frame from the host view’s ","type":"text"},{"inlineContent":[{"type":"text","text":"frame"}],"type":"emphasis"},{"text":" on every layout pass","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"THEOplayerRCTView.layoutSubviews","type":"codeVoice"},{"text":" does ","type":"text"},{"code":"player.frame = self.frame","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"While the split transform is installed, the host view’s frame is the","type":"text"},{"text":" ","type":"text"},{"text":"transformed bounding box, so each pass applies the layout fraction to the","type":"text"},{"text":" ","type":"text"},{"text":"picture a SECOND time — the content renders at fraction² of its box — and","type":"text"},{"text":" ","type":"text"},{"text":"drifts the picture out of the frozen content mask, exposing black regions","type":"text"},{"text":" ","type":"text"},{"text":"inside the box. react-native-video is immune: its layout stamps sublayers","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"bounds","type":"codeVoice"},{"text":", which a transform never changes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The lock captures the healthy pre-transform frame at acquisition and","type":"text"},{"text":" ","type":"text"},{"text":"re-asserts it (through the host’s own frame API, via ","type":"text"},{"code":"restamp","type":"codeVoice"},{"text":") whenever","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the surface’s layer geometry deviates. Observed on the LAYER: UIView"},{"type":"text","text":" "},{"type":"text","text":"geometry setters are not KVO-compliant, CALayer’s "},{"code":"bounds","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"position","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"— the same technique as the overlay host view’s host-layer observers.","type":"text"}]},{"inlineContent":[{"text":"Construct on the main thread (it reads and may re-stamp view geometry);","type":"text"},{"text":" ","type":"text"},{"code":"release","type":"codeVoice"},{"text":" only invalidates the observations and is safe from any thread.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock":{"title":"ContentLayoutLock","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentLayoutLock","url":"\/documentation\/optiviewadsruntime\/contentlayoutlock","kind":"symbol","abstract":[{"type":"text","text":"Pins a host player’s internal video surface to a fixed frame while the"},{"type":"text","text":" "},{"type":"text","text":"split-layout reflow has a transform installed on the host view (PLAYG-513)."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ContentLayoutLock"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentLayoutLock"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentLayoutLock/init(internalView:desiredFrame:restamp:)":{"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"internalView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UIView","preciseIdentifier":"c:objc(cs)UIView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"desiredFrame"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGRect","preciseIdentifier":"c:@S@CGRect"},{"kind":"text","text":", "},{"kind":"externalParam","text":"restamp"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"CGRect","preciseIdentifier":"c:@S@CGRect"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"