{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/setcontentfetchpolicy(__)"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"]]},"abstract":[{"type":"text","text":"Constrains what the item fetches for the phase the break is in, and puts the"},{"type":"text","text":" "},{"type":"text","text":"integrator’s own settings back at the hand-back."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setContentFetchPolicy"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO","text":"ContentFetchPolicy","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy"},{"kind":"text","text":")"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The phase the break is in.","type":"text"}],"type":"paragraph"}],"name":"policy"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two AVFoundation defaults are wrong while a break holds content."},{"type":"text","text":" "},{"type":"codeVoice","code":"preferredForwardBufferDuration"},{"type":"text","text":" of 0 is “automatic”, under which the engine keeps a"},{"type":"text","text":" "},{"type":"text","text":"live item current with the sliding window — media the ad is replacing — so the pause"},{"type":"text","text":" "},{"type":"text","text":"phase asks for the smallest buffer the API can express instead. And"},{"type":"text","text":" "},{"type":"codeVoice","code":"canUseNetworkResourcesForLiveStreamingWhilePaused"},{"type":"text","text":" of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" lets the seekable range"},{"type":"text","text":" "},{"type":"text","text":"go stale (it reported "},{"type":"codeVoice","code":"nan"},{"type":"text","text":" while paused), which the resume ceiling reads, so playlist"},{"type":"text","text":" "},{"type":"text","text":"refresh is switched ON for the whole break."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"preferredPeakBitRate"},{"type":"text","text":" is capped at the lowest variant for the pause only. A paused"},{"type":"text","text":" "},{"type":"text","text":"item otherwise walks the ladder down on its own and re-fetches the paused segment on"},{"type":"text","text":" "},{"type":"text","text":"every rung (42 of 42 pause-phase fetches were down-switches), which also moves the"},{"type":"text","text":" "},{"type":"text","text":"seekable range between variants. The run-up and the hand-back put the integrator’s own"},{"type":"text","text":" "},{"type":"text","text":"value back, so the cap never limits playback."}]}]}],"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/setContentFetchPolicy(_:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"OptiViewAdsRuntime"}],"role":"symbol","externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC21setContentFetchPolicyyy0abC4Core0hiJ0OF","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ContentFetchPolicy","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO","kind":"typeIdentifier"},{"kind":"text","text":")"}]