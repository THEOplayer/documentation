{"kind":"symbol","identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/setContentFetchPolicy(_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/setcontentfetchpolicy(__)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"]]},"sections":[],"abstract":[{"text":"Constrains what the item fetches for the phase the break is in, and puts the","type":"text"},{"text":" ","type":"text"},{"text":"integrator’s own settings back at the hand-back.","type":"text"}],"metadata":{"externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC21setContentFetchPolicyyy0abC4Core0hiJ0OF","role":"symbol","modules":[{"name":"OptiViewAdsRuntime"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ContentFetchPolicy","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"roleHeading":"Instance Method","title":"setContentFetchPolicy(_:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"policy","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ContentFetchPolicy","kind":"typeIdentifier","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO"},{"text":")","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The phase the break is in.","type":"text"}],"type":"paragraph"}],"name":"policy"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Two AVFoundation defaults are wrong while a break holds content."},{"type":"text","text":" "},{"type":"codeVoice","code":"preferredForwardBufferDuration"},{"type":"text","text":" of 0 is “automatic”, under which the engine keeps a"},{"type":"text","text":" "},{"type":"text","text":"live item current with the sliding window — media the ad is replacing — so the pause"},{"type":"text","text":" "},{"type":"text","text":"phase asks for the smallest buffer the API can express instead. And"},{"type":"text","text":" "},{"type":"codeVoice","code":"canUseNetworkResourcesForLiveStreamingWhilePaused"},{"type":"text","text":" of "},{"code":"false","type":"codeVoice"},{"text":" lets the seekable range","type":"text"},{"text":" ","type":"text"},{"text":"go stale (it reported ","type":"text"},{"code":"nan","type":"codeVoice"},{"text":" while paused), which the resume ceiling reads, so playlist","type":"text"},{"text":" ","type":"text"},{"text":"refresh is switched ON for the whole break.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"preferredPeakBitRate"},{"type":"text","text":" is capped at the lowest variant for the pause only. A paused"},{"type":"text","text":" "},{"type":"text","text":"item otherwise walks the ladder down on its own and re-fetches the paused segment on"},{"type":"text","text":" "},{"type":"text","text":"every rung (42 of 42 pause-phase fetches were down-switches), which also moves the"},{"type":"text","text":" "},{"type":"text","text":"seekable range between variants. The run-up and the hand-back put the integrator’s own"},{"type":"text","text":" "},{"type":"text","text":"value back, so the cap never limits playback."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter":{"title":"AVPlayerAdapter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AVPlayerAdapter","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/optiviewadsruntime\/avplayeradapter","navigatorTitle":[{"text":"AVPlayerAdapter","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"AVFoundation implementation of the portable "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" (P5b)."}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentFetchPolicy":{"abstract":[],"title":"ContentFetchPolicy","url":"\/documentation\/optiviewadsruntime\/contentfetchpolicy","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ContentFetchPolicy"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentFetchPolicy"}],"type":"topic","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"role":"collection","abstract":[{"type":"text","text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the"},{"type":"text","text":" "},{"type":"text","text":"overlay ad renderer, and the Google IMA integrations."}],"url":"\/documentation\/optiviewadsruntime","type":"topic","title":"OptiViewAdsRuntime","kind":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter/setContentFetchPolicy(_:)":{"abstract":[{"text"