{"metadata":{"externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC21setContentFetchPolicyyy0abC4Core0hiJ0OF","symbolKind":"method","modules":[{"name":"OptiViewAdsRuntime"}],"role":"symbol","title":"setContentFetchPolicy(_:)","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ContentFetchPolicy","kind":"typeIdentifier","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO"},{"text":")","kind":"text"}]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/setContentFetchPolicy(_:)"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"]]},"abstract":[{"text":"Constrains what the item fetches for the phase the break is in, and puts the","type":"text"},{"text":" ","type":"text"},{"text":"integrator’s own settings back at the hand-back.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"policy","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ContentFetchPolicy","kind":"typeIdentifier","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy"},{"text":")","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"parameters":[{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"The phase the break is in.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two AVFoundation defaults are wrong while a break holds content."},{"type":"text","text":" "},{"type":"codeVoice","code":"preferredForwardBufferDuration"},{"type":"text","text":" of 0 is “automatic”, under which the engine keeps a"},{"type":"text","text":" "},{"type":"text","text":"live item current with the sliding window — media the ad is replacing — so the pause"},{"type":"text","text":" "},{"type":"text","text":"phase asks for the smallest buffer the API can express instead. And"},{"type":"text","text":" "},{"type":"codeVoice","code":"canUseNetworkResourcesForLiveStreamingWhilePaused"},{"type":"text","text":" of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" lets the seekable range"},{"type":"text","text":" "},{"type":"text","text":"go stale (it reported "},{"type":"codeVoice","code":"nan"},{"type":"text","text":" while paused), which the resume ceiling reads, so playlist"},{"type":"text","text":" "},{"type":"text","text":"refresh is switched ON for the whole break."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"preferredPeakBitRate"},{"type":"text","text":" is capped at the lowest variant for the pause only. A paused"},{"type":"text","text":" "},{"type":"text","text":"item otherwise walks the ladder down on its own and re-fetches the paused segment on"},{"type":"text","text":" "},{"type":"text","text":"every rung (42 of 42 pause-phase fetches were down-switches), which also moves the"},{"type":"text","text":" "},{"type":"text","text":"seekable range between variants. The run-up and the hand-back put the integrator’s own"},{"type":"text","text":" "},{"type":"text","text":"value back, so the cap never limits playback."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/setcontentfetchpolicy(__)"]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter/setContentFetchPolicy(_:)":{"role":"symbol","kind":"symbol","title":"setContentFetchPolicy(_:)","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/setContentFetchPolicy(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO","text":"ContentFetchPolicy","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/optiviewadsruntime\/avplayeradapter\/setcontentfetchpolicy(__)","abstract":[{"text":"Constrains what the item fetches for the phase the break is in, and puts the","type":"text"},{"text":" ","type":"text"},{"text":"integrator’s own settings back at the hand-back.","type":"text"}],"type":"topic"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter":{"url":"\/documentation\/optiviewadsruntime\/avplayeradapter","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AVPlayerAdapter"}],"kind":"symbol","abstract":[{"type":"text","text":"AVFoundation implementation of the portable "},{"type":"codeVoice","code":"PlayerAdapter"},{"type":"text","text":" (P5b)."}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter","title":"AVPlayerAdapter","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVPlayerAdapter"}]},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","url":"\/documentation\/optiviewadsruntime","