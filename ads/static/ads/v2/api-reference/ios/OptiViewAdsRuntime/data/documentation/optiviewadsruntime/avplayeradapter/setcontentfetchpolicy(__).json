{"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/setContentFetchPolicy(_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/setcontentfetchpolicy(__)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setContentFetchPolicy"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"policy"},{"kind":"text","text":": "},{"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy","kind":"typeIdentifier","text":"ContentFetchPolicy","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO"},{"kind":"text","text":")"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"policy","content":[{"inlineContent":[{"type":"text","text":"The phase the break is in."}],"type":"paragraph"}]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Two AVFoundation defaults are wrong while a break holds content."},{"type":"text","text":" "},{"type":"codeVoice","code":"preferredForwardBufferDuration"},{"type":"text","text":" of 0 is “automatic”, under which the engine keeps a"},{"type":"text","text":" "},{"type":"text","text":"live item current with the sliding window — media the ad is replacing — so the pause"},{"type":"text","text":" "},{"type":"text","text":"phase asks for the smallest buffer the API can express instead. And"},{"type":"text","text":" "},{"type":"codeVoice","code":"canUseNetworkResourcesForLiveStreamingWhilePaused"},{"type":"text","text":" of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" lets the seekable range"},{"type":"text","text":" "},{"type":"text","text":"go stale (it reported "},{"type":"codeVoice","code":"nan"},{"type":"text","text":" while paused), which the resume ceiling reads, so playlist"},{"type":"text","text":" "},{"type":"text","text":"refresh is switched ON for the whole break."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"preferredPeakBitRate","type":"codeVoice"},{"text":" is capped at the lowest variant for the pause only. A paused","type":"text"},{"text":" ","type":"text"},{"text":"item otherwise walks the ladder down on its own and re-fetches the paused segment on","type":"text"},{"text":" ","type":"text"},{"text":"every rung (42 of 42 pause-phase fetches were down-switches), which also moves the","type":"text"},{"text":" ","type":"text"},{"text":"seekable range between variants. The run-up and the hand-back put the integrator’s own","type":"text"},{"text":" ","type":"text"},{"text":"value back, so the cap never limits playback.","type":"text"}]}],"kind":"content"}],"metadata":{"role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setContentFetchPolicy"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ContentFetchPolicy","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO"},{"kind":"text","text":")"}],"modules":[{"name":"OptiViewAdsRuntime"}],"roleHeading":"Instance Method","externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC21setContentFetchPolicyyy0abC4Core0hiJ0OF","title":"setContentFetchPolicy(_:)"},"abstract":[{"text":"Constrains what the item fetches for the phase the break is in, and puts the","type":"text"},{"text":" ","type":"text"},{