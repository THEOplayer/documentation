{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Constrains what the item fetches for the phase the break is in, and puts the"},{"type":"text","text":" "},{"type":"text","text":"integrator’s own settings back at the hand-back."}],"metadata":{"title":"setContentFetchPolicy(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setContentFetchPolicy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ContentFetchPolicy","kind":"typeIdentifier","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO"},{"text":")","kind":"text"}],"externalID":"s:18OptiViewAdsRuntime15AVPlayerAdapterC21setContentFetchPolicyyy0abC4Core0hiJ0OF","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"OptiViewAdsRuntime"}],"symbolKind":"method"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/optiviewadsruntime\/avplayeradapter\/setcontentfetchpolicy(__)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter\/setContentFetchPolicy(_:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setContentFetchPolicy"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"policy"},{"kind":"text","text":": "},{"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy","preciseIdentifier":"s:15OptiViewAdsCore18ContentFetchPolicyO","kind":"typeIdentifier","text":"ContentFetchPolicy"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The phase the break is in.","type":"text"}]}],"name":"policy"}],"kind":"parameters"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Two AVFoundation defaults are wrong while a break holds content."},{"type":"text","text":" "},{"code":"preferredForwardBufferDuration","type":"codeVoice"},{"type":"text","text":" of 0 is “automatic”, under which the engine keeps a"},{"type":"text","text":" "},{"text":"live item current with the sliding window — media the ad is replacing — so the pause","type":"text"},{"text":" ","type":"text"},{"text":"phase asks for the smallest buffer the API can express instead. And","type":"text"},{"text":" ","type":"text"},{"code":"canUseNetworkResourcesForLiveStreamingWhilePaused","type":"codeVoice"},{"text":" of ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" lets the seekable range","type":"text"},{"text":" ","type":"text"},{"text":"go stale (it reported ","type":"text"},{"code":"nan","type":"codeVoice"},{"text":" while paused), which the resume ceiling reads, so playlist","type":"text"},{"text":" ","type":"text"},{"text":"refresh is switched ON for the whole break.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"preferredPeakBitRate"},{"type":"text","text":" is capped at the lowest variant for the pause only. A paused"},{"type":"text","text":" "},{"type":"text","text":"item otherwise walks the ladder down on its own and re-fetches the paused segment on"},{"type":"text","text":" "},{"type":"text","text":"every rung (42 of 42 pause-phase fetches were down-switches), which also moves the"},{"type":"text","text":" "},{"type":"text","text":"seekable range between variants. The run-up and the hand-back put the integrator’s own"},{"type":"text","text":" "},{"type":"text","text":"value back, so the cap never limits playback."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","doc:\/\/optiviewadsruntime.O