rms":["iOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The phase the break is in."}],"type":"paragraph"}],"name":"policy"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Two AVFoundation defaults are wrong while a break holds content.","type":"text"},{"text":" ","type":"text"},{"code":"preferredForwardBufferDuration","type":"codeVoice"},{"text":" of 0 is “automatic”, under which the engine keeps a","type":"text"},{"text":" ","type":"text"},{"text":"live item current with the sliding window — media the ad is replacing — so the pause","type":"text"},{"text":" ","type":"text"},{"text":"phase asks for the smallest buffer the API can express instead. And","type":"text"},{"text":" ","type":"text"},{"code":"canUseNetworkResourcesForLiveStreamingWhilePaused","type":"codeVoice"},{"text":" of ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" lets the seekable range","type":"text"},{"text":" ","type":"text"},{"text":"go stale (it reported ","type":"text"},{"code":"nan","type":"codeVoice"},{"text":" while paused), which the resume ceiling reads, so playlist","type":"text"},{"text":" ","type":"text"},{"text":"refresh is switched ON for the whole break.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"preferredPeakBitRate","type":"codeVoice"},{"text":" is capped at the lowest variant for the pause only. A paused","type":"text"},{"text":" ","type":"text"},{"text":"item otherwise walks the ladder down on its own and re-fetches the paused segment on","type":"text"},{"text":" ","type":"text"},{"text":"every rung (42 of 42 pause-phase fetches were down-switches), which also moves the","type":"text"},{"text":" ","type":"text"},{"text":"seekable range between variants. The run-up and the hand-back put the integrator’s own","type":"text"},{"text":" ","type":"text"},{"text":"value back, so the cap never limits playback.","type":"text"}]}]}],"references":{"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter":{"navigatorTitle":[{"kind":"identifier","text":"AVPlayerAdapter"}],"title":"AVPlayerAdapter","url":"\/documentation\/optiviewadsruntime\/avplayeradapter","abstract":[{"type":"text","text":"AVFoundation implementation of the portable "},{"code":"PlayerAdapter","type":"codeVoice"},{"type":"text","text":" (P5b)."}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AVPlayerAdapter"}],"identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/AVPlayerAdapter"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime":{"abstract":[{"text":"The iOS and tvOS runtime of the OptiView Ads SDK: the AVFoundation content-player adapter, the","type":"text"},{"text":" ","type":"text"},{"text":"overlay ad renderer, and the Google IMA integrations.","type":"text"}],"title":"OptiViewAdsRuntime","type":"topic","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime","kind":"symbol","url":"\/documentation\/optiviewadsruntime","role":"collection"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/ContentFetchPolicy":{"url":"\/documentation\/optiviewadsruntime\/contentfetchpolicy","title":"ContentFetchPolicy","navigatorTitle":[{"kind":"identifier","text":"ContentFetchPolicy"}],"role":"symbol","abstract":[],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentFetchPolicy","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/optiviewadsruntime.OptiViewAdsRuntime\/documentation\/OptiViewAdsRuntime\/ContentFetchPolicy","type":"topic"},"doc://optiviewadsruntime.OptiViewAdsRuntime/documentation/OptiViewAdsRuntime/AVPlayerAdapter/setContentFetchPolicy(_:)":{"url":"\/documentat